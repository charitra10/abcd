#include <bitset>
#include "helper.hpp"
#include <algorithm>
#include <array>
#include <cmath>
#include <memory>
#include <optional>
#include <string>
#include <vector>

// Behaviour tracing for offline analysis: build a scratch copy with BOT_DIAG defined and run `unswbc run -v`.
// Never enabled in a submitted build (every stderr write costs 2.5M points in the judge).
#ifdef BOT_DIAG
#include <cstdio>
#include <cstdlib>
#include <sstream>
// DIAG_OUT=<file>: every dragon process appends its lines there (one write per line), instead of stderr through `-v`.
inline std::FILE *diag_file() {
    static std::FILE *f = [] {
        const char *p = std::getenv("DIAG_OUT");
        std::FILE *g = p ? std::fopen(p, "a") : nullptr;
        if (g) std::setvbuf(g, nullptr, _IOLBF, 1 << 12);
        return g ? g : stderr;
    }();
    return f;
}
#define DIAG(x) do { std::ostringstream diag_os_; diag_os_ << "DIAG " << x << '\n'; std::fputs(diag_os_.str().c_str(), diag_file()); } while (0)
#else
#define DIAG(x) ((void)0)
#endif

namespace bot {
using namespace unswbc;

constexpr int MAX_CELLS = 4096, INF = 100000;
constexpr int BFS_Q = MAX_CELLS;
constexpr int SONAR_TTL = 36, SONAR_ID_MASK = 8191;
const auto DIRS = Direction::get_direction_list();

// Adaptive kamikaze regime: trade 1-for-1 once our unit lead is decisive. v5.1 triggers at a smaller lead
// than v5 (5 / 1.5x): with random pearl seeds, pressing an early lead wins far more often (dilemma 8/16 -> 16/16).
constexpr int REGIME_MIN_UNITS = 7, REGIME_LEAD = 3, REGIME_RATIO_X10 = 13;

// Kamikaze threshold as a fraction of base_kamikaze_threshold(), in tenths, below / from map_scale() 20.
constexpr int KAM_SMALL_X10 = 7, KAM_LARGE_X10 = 5;

// v5.2 modules. Each one can be switched off on its own so it can be benchmarked in isolation.
constexpr bool F_HAZARD = true;         // trapped dragons broadcast their pocket's mouth; others stay out
constexpr bool F_PORTAL_EVICT = true;   // leave barren / crowded portal enclosures, or die to free them
constexpr bool F_PORTAL_CLEAR = true;   // don't loiter on or route through tiles with a portal edge
constexpr bool F_PORTAL_RESERVE = true; // sonar reservations: at most one dragon per small enclosure
constexpr bool F_DISPERSE = true;       // soft repulsion from friendly bodies, break single-file queues
constexpr bool F_CYCLE = true;          // detect periodic movement and perturb out of it
constexpr bool F_FEED_ADAPT = true;     // long feeders deliver first, short ones later
constexpr bool F_FEED_BACKOFF = true;   // feeders hold while the apex already has pearls piled up
constexpr bool F_ALPHA_MEMORY = true;   // alphas keep a queue of pearls they saw and return for them

// v5.3 modules, switchable the same way.
constexpr bool F_REPEL = true;        // repulsion field between non-alpha heads; a crowd fans out to new ground
constexpr bool F_CYCLE2 = true;       // loop detection by distinct tiles visited, and a breakout away from the loop
constexpr bool F_PORTAL_FIX = true;   // portal hesitation fixes (residency, occupancy expiry, preemption, unseen ends)
constexpr bool F_ALPHA_PORTAL = true; // before ALPHA_PORTAL_ROUND the alpha takes a free portal and hands its role on
constexpr bool F_STRADDLE = true;     // never split while the body straddles a portal
constexpr bool F_HANDOVER = true;     // an L-2 split passes the alpha role to the rear child, the short front hunts
constexpr bool F_LONG_PORTAL = true;  // long dragons stay out of portals; forced in, only a 2-long head goes
constexpr bool F_HAZARD_RR = true;    // relay every live hazard in rotation, not only the freshest
constexpr bool F_FANOUT = false;      // (part of F_REPEL) a crowd of 3+ heads fans out to new ground
constexpr int REPEL_W = 3;            // repulsion weight: REPEL_W * (5 - d)^2 per non-alpha head within 4
constexpr int LONG_PORTAL_LEN = 8, ALPHA_PORTAL_ROUND = 50, FRIEND_PORTAL_TTL = 40;
// Who stays a portal resident on arrival: 0 everyone (v5.2), 1 only in a small sealed enclosure,
// 2 everyone except a dragon that comes out where nothing in view spawns pearls.
// v5.9 (task 5, schooltime round 73): residency is why that dragon walked past the portal (it had come out of another portal
// where things spawn). Mode 1 (only a small sealed chamber makes a resident) measured 93 vs 102/192 against v5.8 (schooltime
// 4 vs 9, slithery_fight 9 vs 14, stronghold 7 vs 11; only portals gained, 12 vs 8): kept at 2.
// v5.9b (task 9): 3 = as 2, and also free when we come out onto wide open ground with no pearl in view and none due within 10
// rounds; it still shuns the portal it came through for 20 rounds (no ping-pong). 4 = the same with nothing due within 40
// (schooltime's rooms spawn on long timers: mode 3 let dragons walk out of them, seed 702 lost with it, won with mode 2).
constexpr int PORTAL_RESIDENCY = 4;
// audit53: fixes from the behavioural audit of the v5.3 modules (audit53/, strategyV_5_9_audit53.md), switchable the same way.
// F_STRADDLE: 152 splits (child > 2) in 78 games had the body across a portal. A split child whose parent straddled one is
// born straddling it; it never crossed, and the segment facing across was out of view, so it split again straight away
// (slithery_fight: a chain of 10-long children every 2 rounds, each 2-long head dying within 4 rounds). Now a body chain
// that ends in view (all its neighbours visible) short of our length also counts: the rest of the body is behind a portal.
constexpr bool F_STRADDLE_SEEN = true;
// F_CYCLE2: during a loop breakout, farm / scout / crowd / convergence targets (v5.6-v5.8) took over the steering on 826 of
// 2707 breakout turns and led the dragon back; only 43% of breakouts got 5 tiles away. They now wait for the breakout, and
// the patrol target is the breakout point itself rather than the best-scored tile in view. And a dragon circling on purpose
// (waiting for a rendezvous, feeding, in ambush) is not broken out: those were 42% of the breakouts.
constexpr bool F_BREAKOUT_HOLD = true;
// F_ALPHA_PORTAL: the alpha named "the longest teammate in view" as its heir, but the handover goes by sonar and stops at
// kelp: 0 of 13 heirs in 78 games heard it (trauma's walls stopped three of four beams at the sender). The heir is now the
// longest teammate a straight beam from our head reaches. In the same 78 games none was, so the capture releases the role
// (as it did in effect before); the endgame apex election refills it.
constexpr bool F_HEIR_BEAM = true;

// v5.4 modules, switchable the same way.
constexpr bool F_SPAWN_CASCADE = true; // round 0: split L-2 again and again, so every spawn body is 2-long units at once
constexpr bool F_REVERSE_SPLIT = true; // no move that survives: split L-2 (the 2-long head dies), even across a portal
constexpr bool F_CAMP = true;          // stay in a portal chamber while its pearls are due; one dragon per chamber
// (Audit: F_CAMP has no effect while F_CAMP2 is on: F_CAMP2 recomputes both `idle` and `crowded`. Every game is identical
// with it off. Camping as it runs now is F_CAMP2 + F_DRY_EVICT.)
constexpr bool F_PORTAL_LOOP = true;   // walked out of a dense chamber: loop round the partner edge and go back in
constexpr bool F_CHAIN = true;         // leave a chamber by a portal we did not just use (chained rooms, no ping-pong)
constexpr bool F_PORTAL_TRAP = true;   // never cross a portal into a dead cell; a portal with dead cells on both sides is barred
constexpr bool F_SKIRMISH = true;      // 2-long dragons ignore enemy risk on pearls and ram any longer enemy head in reach
constexpr bool F_FEED_GATE = true;     // a feeder dies only beside a real, reachable apex that no enemy is closer to
constexpr bool F_GATE_REACH = true;    // (part of F_FEED_GATE) ...and only where the apex can walk to the drop
constexpr bool F_TRUE_LEN = true;      // track alphas' real lengths (v5.3 floored every sonar report at 8)
constexpr bool F_SURPLUS = true;       // feeders the apex cannot use yet take value trades instead of circling
constexpr int CAMP_HORIZON = 30, LOOP_CHAMBER = 8, LOOP_TTL = 12, CHAIN_MEMORY = 4, CHAIN_PENALTY = 12;
// Audit of the v5.4 modules (audit54/, strategyV_5_9_audit54.md): fixes where a module did not do what it was built for.
constexpr bool F_CASCADE_EXIT = true;  // round 0: a cascade child too short to split on is not born where it cannot move
constexpr bool F_RESCUE_GATE = true;   // a trapped feeder skips its rescue split only when the feed gate lets it deliver
constexpr bool F_FAMILY_PORTAL = true; // a newborn with its tail on a portal tile keeps out of that portal (its parent is behind it)
constexpr bool F_BARRED_AIM = true;    // the barred-portal hand-off to a split child is aimed at the child, and shares beams
constexpr int FAMILY_TTL = 20, FAMILY_TTL_EVAC = 0; // an evacuee (born inside) leaves at once: its parent keeps out

// v5.5 modules, switchable the same way.
constexpr bool F_CHOKE = true;        // dead ends and sonar hazard mouths: only a 2-long dragon enters, and only for live pearls
constexpr bool F_CAMP2 = true;        // exactly one camper per paying chamber (yield only to a lower ID), remembered spawn timers
constexpr bool F_BACK_HARVEST = true; // pearls behind our tail that the head cannot reach: split a 2-long child onto them
constexpr bool F_CASCADE_FIX = true;  // round 0: every spawn body cascades, however long (v5.4 skipped "growing" alphas)
constexpr bool F_MANTLE = true;       // an alpha's split hands the role to the larger rear child, never to the 2-long head
// v5.6: off. Handing the role down the round-0 cascade lost dilemma 0/16 to v5.4 (11-13/16 without it), and on fresh
// seeds 9-16 (576 games vs v5.4 and v5.3) the bot scores 52.3% without it, 47.6% with it.
constexpr bool F_MANTLE_CASCADE = false; // (part of F_MANTLE) the round-0 cascade passes the role down its chain too
constexpr bool F_MANTLE_PROMOTE = false; // (part of F_MANTLE) a feeder longer than the apex it reaches takes the role
constexpr int MANTLE_MIN_CHILD = 4;    // smallest split child that takes the alpha role (3 in the round-0 cascade)
constexpr int CAMP_DENSE_HORIZON = 60, CAMP_SOON = 12, HARVEST_COOLDOWN = 6, MANTLE_GUARD = 40;

// v5.6 modules, switchable the same way.
constexpr bool F_DRY_EVICT = true;    // leave a portal chamber at once when no pearl lies in it and none is due soon
constexpr bool F_CHOKE_GREEDY = true; // inside a dead end: no split while pearls lie ahead; split L-2 only at the tip
constexpr bool F_REENTRY = true;      // a camper pushed out through its portal (no other move) walks straight back in
constexpr bool F_SYMMETRY = true;     // infer the map's symmetry from what we see, and share it on sonar
constexpr bool F_MIRROR_SCOUT = true; // (needs F_SYMMETRY) report the mirror image of a rich spot; idle foragers go there
constexpr int DRY_HORIZON = 24, DRY_SHUN = 40, REENTRY_TTL = 12;
// Symmetry candidates: 180-degree rotation, x -> W-1-x, y -> H-1-y, and x <-> y (square maps only).
constexpr int SYM_ROT = 0, SYM_MX = 1, SYM_MY = 2, SYM_DIAG = 3, SYM_RESOLVE = 8;
constexpr int SCOUT_TTL = 60, SCOUT_MIN_PEARLS = 5, SCOUT_MIN_SPAWNERS = 4, SCOUT_GAP = 10, MAX_SCOUTS = 4;
constexpr int SCOUT_ALPHA_X100 = 35;   // the mirror point must lie at least 0.35 * min(W, H) away
constexpr double SCOUT_SATURATION = 4.0; // average pearls in view above which every spot is ordinary

// v5.7 modules, switchable the same way (task numbers from the v5.7 brief, see strategyV_5_7.md).
constexpr bool F_CHOKE2 = true;        // 1, 9: any length enters a dead end, but only for >= CHOKE_MIN_PEARLS live pearls
constexpr bool F_RENDEZVOUS = true;    // 2: remember clusters of tiles due to spawn together and be there on time
constexpr bool F_SPLIT_CAP = true;     // 3: no voluntary non-alpha split while the team has > UNIT_CAP units
// 4: the kamikaze regime is exactly "more than UNIT_CAP units". Off: 46 -> 64/128 vs v5.6 when switched off (seeds 1-4);
// small maps never reach 33 units, so they never pressed an early lead (the adaptive regime of v5.1 stays).
constexpr bool F_KAM_CAP = false;
constexpr bool F_PROTECT = true;       // 5: a suicide strike needs a teammate nearer the collision than any other enemy
constexpr bool F_ASSASSIN = true;      // 5: above the cap, long neutrals ram intruders near our crowd; small ones converge
// 6: barren zones (and their mirror images) on sonar; explorers stay out. Off: 67 -> 76/128 when switched off (seeds 5-8);
// on devil / autarky nearly every view is barren (tiles that never spawn), so it only diverted explorers and beams.
constexpr bool F_BARREN = false;
constexpr bool F_BARREN_SONAR = true;  // (part of F_BARREN) share zones on sonar; off: each dragon keeps its own
constexpr bool F_SPLIT_COOL = true;    // 7: a newborn L-2 rear (rescue / choke split) makes no voluntary split for a while
constexpr bool F_PORTAL_COST = true;   // 8: routes pay extra for tiles with a portal edge; loitering there costs more
constexpr bool F_SCOUT_NEAR = true;    // 10: a mirrored spot only has to lie outside our view (trophy: 5 tiles over the seam)
// 11: explore outward from the map centre, fanned {left, straight, right} by ID. Off: -8/128 in two rounds (devil 0/8,
// autarky 1/8 with it: explorers leave rich centres); the newborn-only and facing-based modes also lost (62, 61 vs 67).
constexpr bool F_HYBRID = false;
constexpr bool F_TAIL_DROP = true;     // 12: back harvest also takes pearls beside the tail, not only on its old path
// (part of F_HYBRID) 1: always, outward from the centre; 2: only for HYBRID_TTL rounds after birth (the fan-out after a
// split), then the v5.6 sector waypoints; 3: always, but "forward" is the way we face, not outward from the centre.
constexpr int HYBRID_MODE = 1, HYBRID_TTL = 20;
constexpr int SCALE_MODE = 1;          // 13: map_scale() = 0: sqrt(W * H) (v5.6), 1: (W + H) / 2, 2: max(W, H)
// v5.7 ladder fixes (a1..a8.png, see strategyV_5_7.md "Ladder bugs").
constexpr bool F_ROUTE_MEM = true;     // a2, a3: out-of-view targets are routed over the remembered map (all map sizes)
constexpr bool F_REM_COMMIT = true;    // a3: keep the remembered pearl we set off for (it flipped between two every turn)
constexpr bool F_PAIR_SEP = true;      // a2: teammates travelling side by side with nothing to eat split up
// a2: exploration sectors by a hash of the ID (by id / 2, siblings shared them). Off: 77 vs 73/128 without it (seeds 5-8),
// and the first version of the a2 fix (hash + pair rule) lost 18/128; the pair rule alone is neutral (74 vs 73).
constexpr bool F_SECTOR_HASH = false;
constexpr bool F_SCOUT_NEARER = true;  // a2: leave a scout spot to a teammate in view that is nearer to it
constexpr bool F_PORTAL_ROAM = true;   // a8: residency and our own portal occupancy expire; idle dragons may use portals
constexpr bool F_CHAMBER_ONE = true;   // a6: a teammate nearer the chamber portal, or crossing it now, has it
constexpr bool F_FEED_CLEAR = true;    // a5: endgame feeders never box the apex in; late feeders deliver, not hold
constexpr bool F_CHOKE_LOOP = true;    // a7: the rear of an escape split stays out of dead ends for a while
constexpr bool F_TAIL_BFS = true;      // a4: tail harvest finds the tail on the visible body and pearls reachable from it
// a1: report rich spots themselves (and mirrors); crowded dragons go to them. Off (v5.7 check, strategyV_5_10_v57check.md):
// small idle dragons it sends to a spot eat 0.60-0.80 pearls in the next 30 turns against 0.93 for idle dragons left to
// explore; v5.10's F_ZONE_CAP moves crowds on. Off vs v5.10: 55.5% +- 2.2 (520 games); with the four fixes: 59.5% +- 2.9 (296).
// v5.12a: back on. With it off, dilemma went 16/16 -> 0/16 (v5.11a) and 13/16 (v5.12a) against v5.10: a dragon sent to a
// reported rich spot at round 12 (then to the farm beside it) is what holds dilemma's centre. v5.12a with it on, 13 maps,
// seeds 1111-1118, both sides: 131/208 vs v5.10 (off: 127), 127/208 vs v5.9 (off: 119).
constexpr bool F_HOTSPOT2 = true;
constexpr int SCOUT_CLAIM_TTL = 25;
constexpr int ROAM_IDLE = 8, DEADEND_COOL = 40, PAIR_TURNS = 3, CROWD_HEADS = 2, LATE_FEED = 30;
constexpr int CHOKE_MIN_PEARLS = 2, UNIT_CAP = 33, SPLIT_COOL = 8;
constexpr int PROTECT_EXEMPT_LEN = 0;  // an enemy at least this long is worth a strike with nobody to harvest (0: never)
constexpr int ASSASSIN_MIN_LEN = 5, ASSASSIN_CROWD = 2;
constexpr int PORTAL_STEP_COST = 4, PORTAL_LOITER = 110;
constexpr int RDV_MIN = 3, RDV_MAX_WAIT = 60, MAX_RDV = 6;
constexpr int BARREN_HORIZON = 30, BARREN_TTL_CAP = 90, BARREN_R = 3, MAX_BARREN = 8, BARREN_PENALTY = 30;

// v5.8 modules (task numbers from the v5.8 brief, see strategyV_5_8.md), switchable the same way.
constexpr bool F_ISOLATED = true;       // 1: alone among enemies (no teammate head in view): only fair trades, avoid their reach
constexpr bool F_FARM = true;           // 2, 9: farm dead ends that refill fast (>= FARM_MIN pearls a dive), share them
constexpr bool F_FARM_SEEK = true;      // (part of F_FARM) idle dragons walk to a known farm (and its mirror image)
constexpr bool F_EARLY_KILL = true;     // 3: from round 1, a sure kill on an enemy at least as long, with a teammate near
constexpr bool F_CHAMBER_MIRROR = true; // 4: a camper reports the mirror image of its chamber's outside entrance
constexpr bool F_FEED_SCORE = true;     // 6: feed the alpha that ends longest (length vs distance), alphas merge upward
constexpr bool F_STRADDLE_SPLIT = true; // 7: a 2-split is fine with the body across a portal (the tail is where we came from)
constexpr bool F_PORTAL_YIELD = true;   // 8: a portal a teammate is taking or just took is not waited at
constexpr bool F_POCKET_SEEK = true;    // 10: rich spots seen far off (and their mirror images) pull idle foragers
constexpr bool F_PATCH_CAMP = true;     // 11: one dragon per small enclosed pearl patch (not only portal chambers)
constexpr bool F_TRAP_AVOID = true;     // long dragons score moves by the room left, counting our body as it frees up
constexpr bool F_FEED_UNGUARD = true;   // (endgame) a new alpha feeds a clearly longer apex at once (no MANTLE_GUARD wait)
// Exploration waypoints point away from where we were born (they were fixed compass points round the centre: on devil the
// left-side team's "west" waypoints lay in its own barren strip, the right side's crossed the pearl columns; v5.6 against
// itself ate 284 vs 1232 pearls on seed 301 depending on the side).
constexpr bool F_SECTOR_FLIP = true;
constexpr bool F_ROUTE_PORTAL = true;   // (part of F_FARM) routes over the remembered map cross portals we know both ends of
constexpr int FARM_MIN = 3, MAX_FARMS = 8, FARM_TTL = 150, FARM_CLAIM_TTL = 30;
constexpr int ISO_RADIUS = 5, ISO_EARLY = 120, EARLY_KILL_FRIEND = 3;
// (F_ISOLATED) enemy heads within ISO_RADIUS that make us "surrounded"; strikes while isolated: 0 none, 1 only on an enemy at
// least as long (it loses as much as we do), 2 as usual; shortest dragon the rule applies to.
// Strict version (no strikes, refuse what an enemy reaches in 2 steps / 3 early): 87 vs 98/192 without the rule on the
// fight maps (trophy, arena, Colosseum, default_small, seeds 301-308); this one (fair trades allowed, refuse what an enemy
// reaches next move / within 2 early): 97.
constexpr int ISO_MIN_ENEMIES = 1, ISO_STRIKES = 1, ISO_MIN_LEN = 2;
constexpr int ISO_RISK = 360, ISO_RISK_EARLY = 320; // (F_ISOLATED) danger() from which a pearl or a step is refused
constexpr int POCKET_MIN = 6, POCKET_DUE = 100; // (F_POCKET_SEEK) good spawners in a 5x5 that make a rich spot
constexpr int FEED_SWITCH = 2; // (F_FEED_SCORE) segments a new alpha must beat the one we feed by
// (F_FEED_SCORE) an alpha merges into a longer one if the apex then has at least this many rounds to eat the drop (v5.7 asked
// for the whole body length, so late in the game big alphas never merged; only the longest dragon counts, so every pearl the
// apex eats from the drop is a gain).
constexpr int FEED_EAT_MIN = 12;
constexpr int TRAP_MIN_LEN = 5, TRAP_NEED = 14, TRAP_W = 25;
constexpr int PATCH_MAX = 36, PATCH_EXITS = 3, PATCH_HOLD = 40, PATCH_DUE = 40;

// v5.9 modules (task numbers from the v5.9 brief, see strategyV_5_9.md), switchable the same way.
constexpr bool F_FARM_SPLIT = true;     // 1: out of a dead end we farmed, split 2 while longer than 4 (alphas too, before the endgame)
constexpr bool F_QUICK_FARM = true;     // 1: spawners refilling within 5 rounds count for farms (autarky's pocket has [1,5] tiles)
constexpr bool F_EARLY_FEED = true;     // 2: no enemy able to reach us for PEACE_WINDOW rounds: start feeding from EARLY_FEED_ROUND
constexpr bool F_EARLY_KILL2 = true;    // 3: sure kills on enemies 1-2 shorter too, with a teammate right beside the collision
constexpr bool F_ENEMY_CHAMBER = true;  // 4: a chamber we saw an enemy come out of (or go into) is theirs: keep out for a while
constexpr bool F_EXIT_CLEAR = true;     // 6: keep off the outer tiles of small-chamber portals: whoever leaves lands there blind
// 4 (queen_of_spades): room-aware moves for short dragons too, needing room for max(len + 2, 4) tiles. A 2-long camper walked
// into a chamber corner whose only other exit its own split child blocked, then into a 1-tile nook, grew to 3 and died.
constexpr bool F_TRAP_SMALL = true;
// 4 (queen_of_spades): a dragon leaving a crowded chamber could not step onto its portal tile: escape_count() ignored the
// "leaving" exemption forward_escape_count() has, so the tile counted as a dead end. It circled 6 rounds, then died on purpose.
constexpr bool F_EVICT_EXIT = true;
constexpr int FARM_SPLIT_WINDOW = 20, FARM_SPLIT_LEN = 4;
constexpr bool FARM_SPLIT_ALPHA = false; // (F_FARM_SPLIT) alphas too (trauma 7 vs 13/16: it stunts a farming apex)
constexpr int PEACE_WINDOW = 150, EARLY_FEED_ROUND = 250;
constexpr int EARLY_KILL2_GAP = 2, EARLY_KILL2_FRIEND = 2;
constexpr int ENEMY_CHAMBER_TTL = 100, EXIT_LANE_PENALTY = 150;

// v5.9 second brief (ladder replays M510524-M514761; task numbers from that brief, see strategyV_5_9.md), switchable the
// same way.
constexpr bool F_RETREAT = true;        // 1: outnumbered on the enemy's half of the map (by its symmetry): walk back home
constexpr bool F_PORTAL_PROBE = true;   // 2, 3: one beam through a portal before crossing it; its echo says who is behind
constexpr bool F_PROBE_SPLIT = true;    // 2: an enemy right behind the portal we are forced out through: split instead
constexpr bool F_PROBE_EXIT_FREE = false; // 2: with probes on, drop the exit-lane penalty of F_EXIT_CLEAR (ablation)
constexpr bool F_TRUE_MOVES = true;     // 4, 5: who is nearer a pearl or a drop counts moves (walls, facing), not distance
constexpr bool F_BODY_FREE = true;      // 4: our routes may cross our own body where it will have moved off by then
constexpr bool F_SPLIT_ONCE = true;     // 6: a fresh split child whose own child would have no way out does not split again
constexpr bool F_MOUTH_CLEAR = true;    // 6: keep off the mouth of a dead end a teammate is in (its rear child comes out there)
// 7: enemy sprint reach counts the pearls it eats on the way (each pays one more step): 0 off, 1 for late-game alphas (as
// asked), 2 for every dragon that weighs enemy reach.
constexpr int SPRINT_REACH = 1;
constexpr bool F_PEARL_SPRINT = true;   // 7 (ii): our strikes may sprint further by eating pearls on the way
constexpr bool F_FEED_EFF = true;       // 8: feeders grow to an odd length before they drop (ceil(L / 2) pearls)
constexpr bool F_HERD = true;           // 10: hunters step where the enemy they close on has the fewest safe replies
constexpr bool F_LONG_GUARD = true;     // 10: long non-alphas weigh enemy reach (and split away from it) like alphas
constexpr bool F_LANE = true;           // 11: one-way corridors: a dragon in one beams along it; teammates keep out
constexpr bool F_ENEMY_LEN = true;      // 12: remember enemy lengths seen whole; a half-seen enemy is not assumed 4 long
constexpr int ISO_MIN_LEN2 = 3;         // 12: the isolation rule leaves 2-long skirmishers alone (v5.8: 2)
constexpr int RETREAT_TTL = 15, RETREAT_ENEMIES = 2, PROBE_RANGE = 3, LONG_GUARD_LEN = 6, HERD_RANGE = 4;
constexpr int MAX_LANES = 6, MAX_AVOID = 4;
constexpr int RETREAT_MODE = 2; // 1: as first asked (any 2+ enemy heads); 2: only 4+ long dragons facing enemies as long as them
constexpr int FEED_SHIFT = 0; // 8: rounds earlier than v5.9 the endgame consolidation starts (the portals opponent: ~35)

// v5.9c (the kamikaze brief, PD and Default replays): strikes and positioning by the team's profit. See exchanges.py: in 17
// ladder games the enemy started 499 head-on collisions to our 169 and ate 1045 of their drops to our 401.
constexpr bool F_EXCHANGE = true;  // a non-alpha strikes (one step or a sprint, pearls paying) when the exchange pays the team
constexpr bool F_SUPPORT = true;   // small hunters stand by a teammate an enemy can ram, when we would lose the race to the drop
// Expected length gain an exchange strike needs. On 5 open maps 1.5 looked better (+1.34 a strike against +0.98); over all 12
// ladder maps (96 games vs v5.8) 0.5 wins as often (54 vs 53) with a higher exchange balance (+821 vs +589): on crowded maps
// (schooltime, slithery_fight) the drop-race estimate is too pessimistic and 1.5 skips strikes that pay.
constexpr double EXCH_MIN = 0.5;
constexpr int EXCH_FAR = 6, SUPPORT_MAX_LEN = 3, SUPPORT_RANGE = 4;
// The defensive mirror of F_EXCHANGE: non-alphas weigh an enemy strike on the tile they step to, by the enemy's own profit
// (its length lost against ours, and who wins the race to the drop). In the ladder replays our victims were mostly foraging
// or dispersing (204 of 499) or setting up an ambush (68) when an enemy sprinted into them.
constexpr bool F_DODGE = true;
constexpr bool DODGE_SKIRMISH = true; // 2-long non-hunters dodge too
constexpr double DODGE_W = 15.0, DODGE_DIRECT = 2.0; // scorer weight per unit of enemy gain; gain that sends a step to the scorer
// Weight for a forager heading for food (they were hit at -2.02 length each in 40 games vs v5.8), and for a kamikaze setting
// up an ambush (hit 188 times in those games); the defaults keep the plain DODGE_W and no ambush dodging.
constexpr double DODGE_FORAGE_W = 15.0, DODGE_AMBUSH_W = 0.0;
// Kamikazes approach an enemy head down the lane beside its path and ram it from the side; face to face on its line it
// just turns away. FLANK_LINE_PENALTY: what a step onto its line 1-3 tiles ahead costs an ambushing kamikaze.
constexpr bool F_FLANK = true;
// Exchange refinements: skip a strike where their heads outnumber ours near the collision; learn our real share of a drop
// race online (devil 53%, default 85% when our collector was nearer); hunters eat fresh death drops before hunting on.
// 96 games vs v5.8 over the 12 ladder maps, each on top of flank (63 wins, exchange balance +823): outnumbered 64 / +858 (kept);
// learned share 58 / +1027; eat drops first 60 / +507 (hunters walk into the enemy's strike zone: off); all three 61 / +725.
// On new seeds 31-38: outnumbered 53, learned 55, both 55 (the 64 vs 58 was noise, one sd is about 7 in 192): both shipped,
// the learned share for its better trades.
constexpr bool F_EXCH_OUTNUM = true, F_DROP_LEARN = true, F_COLLECT = false;
constexpr int DROP_TTL = 30, DROP_PRIOR = 8, COLLECT_RANGE = 4;
constexpr int FLANK_AHEAD = 4;
constexpr double FLANK_LINE_PENALTY = 35.0;
constexpr bool EXIT_CLEAR_ON = F_EXIT_CLEAR && !(F_PORTAL_PROBE && F_PROBE_EXIT_FREE);

// v5.10 modules (item numbers from the v5.10 brief: ladder battle M604164 and the Aut_1 / Trpy_1 replays; see
// strategyV_5_10.md), switchable the same way.
// 7 (slithery_fight (39..46, 19), every game since v5.7): a dragon born by a rescue split at a farm tip knows the pocket
// behind its birth tail is a dead end even if it never saw it. Without this the "shed 2, not L-2" rule of v5.7 never fired
// there (the far pocket was out of view), and one 6-long dragon split tip to tip for 500 rounds (250 dead heads, net 0).
constexpr bool F_BIRTH_DEAD = true;
constexpr int BIRTH_DEAD_TTL = 16;
// 7 (same map, second chain): a 10-13-long alpha shuttled between (16..18, 7) and the dead end at (20..21, 0..1): alphas were
// exempt from the "shed 2" rule, and a newborn's entry check read its path from recent_path (empty at birth). Alphas shed 2
// when the tail is doomed too, and the entry check reads the path off our body when recent_path is short.
constexpr bool F_CHAIN_ALPHA = true;
// 2 (trauma rounds 29-35): the dead end we sent a split child into is busy for KID_TTL rounds, even out of view. A 4-long
// alpha split a second child into the corridor its first child was farming; the two met head on.
constexpr bool F_KID_MEMORY = true;
constexpr int KID_TTL = 25;
// 12 (Aut_1 round 475): a 66-long apex chased a remembered pearl behind its own coil. Remembered targets must be reachable
// over the remembered map with our own tracked body as walls (freeing from the tail); room checks see our body out of view.
constexpr bool F_OWN_BODY_MEM = true;
constexpr bool F_ROOM_MEM = true; // ...and escape_room() counts remembered ground past the view (our body out of view a wall)
// 4: two teammates going for the same pearl (not a death drop): the longer one has it unless it needs more than
// LONG_FIRST_SLACK moves more (a 3-long dragon eats and splits at once; a 2-long one only grows).
constexpr bool F_LONG_FIRST = true;
constexpr int LONG_FIRST_SLACK = 1;
// 10 (dilemma round 2): a step an enemy head can ram this turn, where their heads outnumber ours within 4 moves, is worth
// dodging even for an even trade (their crowd eats both drops): strike_risk() counts one more unit and weighs x3 there.
constexpr bool F_DODGE_OUTNUM = true;
constexpr double DODGE_OUTNUM_MULT = 3.0;
// 13 (Trpy_1 round 31): no teammate head within GRAB_FRIEND moves and an enemy head able to ram us this turn: sprint through
// the pearls beside us now (each one eaten pays a step) instead of splitting or walking; the enemy took them and our head.
constexpr bool F_PEARL_GRAB = true;
constexpr int GRAB_FRIEND = 3, GRAB_MAX = 4;
// 5 (trauma round 136): two of our dragons face each other in a 1-wide way with no turning off: the smaller (lower length,
// then higher ID) dies on the spot, its pearls in the bigger one's path, and the bigger one counts it gone (no split, no
// turning into a side pocket to dodge a teammate).
constexpr bool F_YIELD = true;
constexpr int YIELD_RANGE = 5;
// 3 (trauma round 80+, and 4 of 6 local trauma games): a portal resident circled a 2x2 block beside the portal for 20+
// rounds: its target (a rendezvous) was routed through a portal residents may not use, and pearls in view behind a wall kept
// it "busy" so residency never lapsed. Routes over the remembered map skip portals we may not cross; only pearls we can
// reach keep a resident busy; a resident (not a camper) caught in a tight loop gives up residency and breaks out.
constexpr bool F_RESIDENT_LOOP = true;
// 6 (trauma round 409): a threatened 28-long alpha split L-2, but its tail lay beside the threat too, so the 26-long child
// was born in the same danger and split again at once. When our tail is within an enemy's reach as well, keep a front just
// long enough to sprint into the nearest enemy head in reach (it strikes next turn) and give the rest to the rear child.
constexpr bool F_FRONT_KILL = true;
constexpr int FRONT_KILL_RANGE = 4;
// 8 (queen_of_spades round 45): dragon 16 left its chamber onto the exit tile a teammate had just stepped onto from outside.
// The teammate's probe reached 16 that same round, but a probe only told its receiver to keep off one tile. Now: every step
// onto a tile beside a portal probes it (not only "portal" moves), so a crossing always has a probe the turn before; a probe
// whose landing tile is our head means someone stands right behind the portal beside us: we do not cross it for 2 rounds;
// and a probe echo from a far side we never saw counts as right behind the portal.
constexpr bool F_PORTAL_HANDSHAKE = true;
// 1 (trophy, M604173 and Trpy_1): 5-9 of our dragons sat in one rich zone (the cup, or one handle) for 100+ rounds while the
// enemy farmed the other two zones and the open ring (half of trophy's income). A rich zone holds one dragon per
// ZONE_PER_DRAGON rich tiles in view (a pearl, or due within ZONE_DUE rounds); above that the highest ID in the crowd leaves
// (to a reported spot, else away from the zone) and keeps off that zone's pearls for ZONE_SHUN rounds.
constexpr bool F_ZONE_CAP = true;
constexpr int ZONE_DUE = 30, ZONE_PER_DRAGON = 4, ZONE_MIN_RICH = 5, ZONE_R = 3, ZONE_SHUN = 25, ZONE_LEAVE_R = 6;
// 9, 11 (queen_of_spades, farms): an enemy inside a small portal chamber (we saw it go in) or inside a farm's dead end can
// only come out onto one tile: the tile it went in from / the farm's mouth. One small dragon (2-3 long) of ours circles the
// 2x2 block through that tile, so whoever comes out runs into its body. The tile is shared on sonar (GUARD_TAG).
// (Claiming the paying chamber or farm itself, and its mirror image, is v5.8's F_CHAMBER_MIRROR / F_FARM_SEEK.)
// Rework (after the first version made 1 kill in 48 games: guards left their post after 1-3 turns, and 40% of guarding
// was in the portals map's crowded middle): a guard commits to its post (claimed on sonar, one per exit) and stays until
// the post expires, it outgrows the 2x2 loop (3 long), the endgame starts or an enemy can ram it at a profit; only chambers
// that spawn and farms are guarded, and not an exit with 2+ of our heads around it.
constexpr bool F_GUARD = true;
// Once the enemy is gone the guard takes the place itself: at a chamber it probes through the portal each time it steps on
// the exit tile, and after GUARD_CLEAR clear probes in a row it goes in (and camps there); at a farm, the whole dead end in
// view with no enemy in it ends the post and the ordinary farm rules take over.
constexpr int GUARD_TTL = 40, GUARD_RANGE = 8, GUARD_DROP = 12, MAX_GUARDS = 8, GUARD_CROWD = 2, GUARD_STUCK = 3,
              GUARD_CLEAR = 2;

// Fixes from checking the v5.7 modules in v5.10 (does each one still do its job?), each switchable for the win-rate check.
// F_TAIL_DROP (task 12) counted pearls within 2 tiles of the tail by straight-line distance. With the whole body in view,
// F_TAIL_BFS has already searched from the tail and found fewer than `need` pearls a child could reach first; the tail-drop
// count then overrode it (509 of 548 of its harvests, on2 seeds 2001-2003), and 49% of those children ate nothing in 10
// rounds (5-9% for the other harvests). Fixed: the beside-the-tail pearls only count when the body is not all in view.
constexpr bool F_TAIL_DROP_FIX = true;
// F_REM_COMMIT (a3) kept a remembered pearl only while no teammate looked nearer (claimed()). By moves, with facing, that
// flips as teammates turn: 16% of the goals given up to a teammate were picked again within 5 rounds (A-B-A), the circling
// a3 was about. Fixed: a claim only breaks the commitment when a teammate is REM_CLAIM_MARGIN moves nearer or the claim
// holds for 2 turns in a row; a pearl given up that way is not picked again for REM_YIELD_TTL rounds.
constexpr bool F_REM_COMMIT_FIX = true;
constexpr int REM_CLAIM_MARGIN = 2, REM_YIELD_TTL = 6;
// F_PAIR_SEP (a2) fired whenever a non-alpha teammate head was within 2 for 3 turns and no pearl was in view: 433 times a
// game (on2), only 27% of them with both dragons idle (exploring); the rest were scouts, rendezvous trips, portal errands
// and ambushing hunters. Each firing wiped our scout goal (its spot stayed claimed on sonar for 25 rounds, so nobody went),
// our rendezvous and our remembered pearl, though in 92% of firings the teammate was not after the same target. Fixed:
// hunters never fire; a dragon on an errand only gives it up (and turns away) when the teammate is nearer to that goal,
// and releases the scout claim when it does; an idle pair splits up as before.
constexpr bool F_PAIR_SEP_FIX = true;
// F_RENDEZVOUS (task 2): 8943 trips in 76 games (on2) reached the cluster 54% of the time and ate there 22%; 72% of trips
// had another of our dragons going to the same cluster (the "nearer teammate" check ran once, at the pick); 61% of arrivals
// were early, circling on the tiles about to spawn (a spawn attempt fails under a body: 3206 blocked, 2022 on slithery);
// after eating, the slot stayed live and pulled the dragon back to the emptied spot. Fixed: a trip ends when a teammate
// in view is nearer to the cluster; an early arrival waits on a tile near it that is not due before the cluster; a cluster
// seen spawned (pearls in view at or after its time) is retired.
constexpr bool F_RDV_FIX = true;

// v5.9d: fixes from the behavioural audit of the v5.2 modules (audit52/, strategyV_5_9d.md), switchable the same way.
// F_HAZARD announced a "trap" whenever bodies ahead closed the flood, so most hazards (81% over 12 maps) marked 1-wide
// corridors open at both ends, and 16% of owners walked back out past their own mouth. Now the region behind the mouth must
// be closed by walls (no other way out; a loop inside is fine: a room crowded with bodies is still a trap while it is full).
constexpr bool F_HAZARD_CLOSED = true;
// F_ALPHA_MEMORY: of 9707 trips to a remembered pearl the alpha ate it on 209 (2%); a teammate ate it first on 3305 (34%)
// and 39% were dropped after about 2 rounds (re-chosen every turn). Alpha pearls per game were the same with it off. Now
// the alpha skips pearls a teammate is nearer to (as the generic memory does), needs a remembered way there, and keeps
// the pearl it set off for (F_REM_COMMIT's rule).
constexpr bool F_AMEM_FIX = true;
// F_PORTAL_RESERVE: 94% of our entries into a chamber a teammate already held were by dragons that never heard its
// reservation: the camper renewed it on one rotating beam, and sonar stops at kelp, so it hit the chamber walls. Now a
// camper sends it on the beam that leaves through its portal (sonar crosses portals) whenever one does. And default's nine
// chambers each have two portals, but only the first one found was ever reserved: newcomers came in by the other one.
constexpr bool F_RESERVE_AIM = false; // measured: settled-chamber entries 125 -> 120 over 48 games (off: 164): not shipped
constexpr bool F_RESERVE_ALL = false; // reserve every portal of the chamber we hold, in rotation (default: 90 vs 43 settled-chamber
                                     // entries in 4 games, worse: off)

// audit56: fixes from the behavioural audit of the v5.6 modules (audit52/analyze56.py, strategyV_5_9_audit56.md).
// F_SYMMETRY: inference is right (0 wrong of 12000 resolutions / adoptions in 72 games), but newborns learn it late: about
// 9 rounds after birth, and 21% never do. F_SYM_HANDOFF gives a split child the symmetry from its parent on the split turn
// (the beam into our own body refracts out of the tail into the child), on beams no other hand-off is using. Measured:
// newborn lag 8.8 -> 7.0 rounds, never 21% -> 18%, 42 vs 46 wins / 72 (and 52 / 72 with no symmetry at all): off.
constexpr bool F_SYM_HANDOFF = false;

// Sonar tags carried in the 13-bit alpha-ID field. 8191 already meant "no alpha"; real IDs never get
// near these values, and every other field of the packet keeps its usual meaning.
constexpr int HAZARD_TAG = 8190, PORTAL_TAG = 8189, HANDOVER_TAG = 8188;
// v5.4: every portal (id < 32) we know is barred, as a bitmask in the low 32 bits. This packet carries no
// other field, so it is decoded before the generic kamikaze / enemy-alpha fields are read.
constexpr int BARRED_TAG = 8187;
// v5.5: the alpha role passes to the split child. Position field = old alpha ID (12 bits), alen = child length
// (the newborn checks it is the one meant), origin = split round. Everybody else drops the old ID as an alpha.
constexpr int MANTLE_TAG = 8186;
// v5.6: map symmetry and mirrored hotspots. Position field = the mirrored spot, origin = round found, alen = symmetry
// type (2 bits) | spot value (4 bits since v5.8, 0: symmetry only, no spot) | symmetry unknown (bit 6, v5.8) | claimed (bit 7).
constexpr int SCOUT_TAG = 8185;
// v5.7: a barren zone. Position field = its centre, origin = round seen, alen = symmetry (2 bits, valid with bit 2: the
// receiver adds the mirror image too) | rounds it stays barren / 4 (5 bits, from bit 3).
constexpr int BARREN_TAG = 8184;
// v5.8: a farm (a dead end that refills fast). Position field = its first tile, origin = round last seen, alen = entry
// direction (2 bits) | fast spawners (4 bits, from bit 2) | speculative mirror (bit 6) | claimed (bit 7).
constexpr int FARM_TAG = 8183;
// v5.9b: a one-way corridor in use (F_LANE). Position field = its far end tile, origin = round, alen = the sender's heading
// (2 bits) | rounds until it is out (5 bits, from bit 2).
constexpr int LANE_TAG = 8182;
// v5.9b: a portal probe (F_PORTAL_PROBE). Position field = the tile the sender comes out on next turn, origin = round.
constexpr int PROBE_TAG = 8181;
// v5.9b: our spawn point (F_RETREAT). Position field = where a round-0 dragon of ours stood.
constexpr int SPAWN_TAG = 8180;
// v5.10: the tile an enemy-held chamber or farm lets out onto (F_GUARD). Position field = that tile, origin = round,
// alen = rounds it stays worth guarding / 4.
constexpr int GUARD_TAG = 8179;
// v5.11: a strike is coming (F_DROP_CALL). Position field = the enemy head we are about to ram, origin = round.
constexpr int DROP_TAG = 8178;

// v5.11 modules (item numbers from the v5.11 brief: M617477, Aut_2, Sch_1, Trpy_2/3; see strategyV_5_11.md).
// 1: a dragon about to ram an enemy head with no teammate near the collision announces the spot the turn before (a dying
// dragon casts no sonar); foragers within DROP_CALL_RANGE go there to eat the drop.
constexpr bool F_DROP_CALL = true;
constexpr int DROP_CALL_RANGE = 10, DROP_CALL_TTL = 6;
// The first version called on three beams every turn a hunter was within 2 of a lone enemy (~40 calls a game): it drowned
// the alpha and hazard relays and cost 8 of 96 games. Now one beam (straight away from the enemy), only for a target at
// least DROP_CALL_MIN long (a drop worth the walk).
constexpr int DROP_CALL_BEAMS = 1, DROP_CALL_MIN = 3;
// 2 (i) (devil M617477 round 21): a rich zone on the map's symmetry line is one for the whole map: both sides race for it.
// Once in view (within CONTEST_RANGE moves), pearls that are not on the way there are left alone.
constexpr bool F_CONTEST_ZONE = true;
constexpr int CONTEST_MIN = 4, CONTEST_RANGE = 8;
// 2 (ii), 5 (ii) (devil round 28, Trpy_2 round 34): an enemy head can get to the pearls next to us as soon as we can: sprint
// through them now when that is a net gain (friends in view or not), and do not split first. A rush: with the contested
// zone a few moves off and an enemy as near, sprint to its nearest pearl.
constexpr bool F_CONTEST_GRAB = false; // measured: 47.4% as the one addition to v5.10 over 192 games (seeds 991-998): a sprint spends length
constexpr int CONTEST_GRAB_MAX = 5;
// 3, 6 (Aut_2 round 39, Trpy_3 round 55-56): where their heads outnumber ours (with us) around a tile, every dragon (hunters
// too) avoids a step an enemy could ram at a profit, and nobody strikes there unless the target is clearly longer.
constexpr bool F_OUTNUM2 = true;
constexpr double OUTNUM_HUNTER_W = 15.0;
// 4 (Sch_1 round 432): every legal move lands where an enemy can ram us next turn at a profit: split now (4+ long), so the
// 2-long head takes it and the rear keeps the mass.
constexpr bool F_FORCED_SPLIT = true;
// 5 (ii): exactly one enemy head in view and a pearl within 2 moves: eat before a routine split (a split costs a move).
constexpr bool F_EAT_FIRST = false; // measured: 47.4% as the one addition to v5.10 over 192 games (seeds 991-998): a delayed split costs the economy
// 5 (i) (Trpy_2 round 34): a small dragon near a teammate that can ram (or be rammed by) an enemy head moves toward the
// collision to eat the drop, before portal errands; hunters and foragers alike.
constexpr bool F_DROP_POS = true;

// v5.12 modules (item numbers from the v5.12 brief: battle M655220, trophy M655229; see strategyV_5_12.md).
// 1 (trophy round 60, our 15 into enemy 21): who reaches a drop first is decided by moves and then by turn order: after
// our strike, dragons with a higher ID than the striker move this same round, lower IDs only next round. The race also
// treats the two dying bodies as open ground (v5.11 routed the enemy's collector round our own striker's body, so enemy 22,
// two moves from the drop and moving before our 14, looked five moves away).
constexpr bool F_TURN_ORDER = true;
constexpr bool F_TURN_ORDER_RISK = true; // (part of 1) the same race when we weigh an enemy's strike on us (the dodge)
constexpr bool F_TO_PROTECT = true;      // (part of 1) the race in strike_protected() (the kill tiers' veto)
constexpr bool F_TO_EXCHANGE = true;     // (part of 1) the race in exchange_value() (the drop share of exchange strikes)
// 2 (trophy round 61, our 14 beside enemy 22): an enemy head about to eat pearls none of ours can reach first: ramming it
// saves them from it. The exchange value counts those pearls (at most DENY_MAX), and the drop call goes out a turn early.
constexpr bool F_DENY = true;
// (part of 1) enemy heads seen within GHOST_TTL rounds and now out of view still race for a drop (as if they walked toward it
// since): of our strikes that still lost the race, most lost it to an enemy 4-5 tiles out, beyond our 7x7 view.
constexpr bool F_GHOST = true;
// A drop call leaves us to the pearls we see (the call spot may have no route, or be eaten already).
constexpr bool F_DROPGO_FIX = true;
constexpr int GHOST_TTL = 3;
constexpr int DENY_MAX = 4, DENY_REACH = 3;
// 3: on small maps, once the team has PAIR_MIN_UNITS units, small non-alphas travel in pairs: a strike by one of them on a
// lone enemy leaves the drop to the other, and an enemy that rams one of them feeds the other. Pairs form by a greedy
// nearest matching over the heads in view (both members see nearly the same heads, so they agree); the higher ID follows
// (keeps within PAIR_R, PAIR_ESCORT with an enemy near), the lower ID leads (turns back beyond PAIR_R + 2). A pair
// member nearer a lone enemy head closes on it (PAIR_HUNT_RANGE); its buddy escorts.
// Small map: W * H <= PAIR_AREA. By area, autarky (54 x 18 = 972) is small, like default (32 x 32): what matters is how
// often enemy heads meet ours, and its 18-tile height funnels traffic along one axis.
constexpr bool F_PAIR = true;
constexpr bool F_PAIR_HUNT = true;
constexpr int PAIR_AREA = 1100, PAIR_MIN_UNITS = 6, PAIR_MAX_LEN = 5, PAIR_MATCH = 5, PAIR_R = 3, PAIR_ESCORT = 2,
              PAIR_LOST_TTL = 4, PAIR_HUNT_RANGE = 5;
constexpr double PAIR_W = 12.0;
// Not before PAIR_START: the round-0 cascade alone gives 6-7 units on dilemma and devil, and pairing from round 1 glued the
// opening dispersal together (dilemma 16/16 -> 0/16, devil 8 -> 2 of 16 against v5.10).
constexpr int PAIR_START = 40;
// Unpaired with nothing to eat: walk to the nearest small teammate we saw within REGROUP_TTL rounds (the first build
// paired only 31-59% of the turns it could: lone dragons had nobody in view).
constexpr bool F_REGROUP = true;
constexpr bool PAIR_TRAIL = true;
constexpr bool PAIR_THREAT_ONLY = false; // keep together only while an enemy head is within 6 of us or our buddy // the follower trails its leader when idle, and leaves pearls far from it
// A kamikaze ambushes (and herds) only with its buddy within PAIR_R: alone, the drop feeds the enemy (ladder trophy M655229:
// 16 of our head-on deaths were kamikazes walking in to ambush; the enemy struck first with its own collector nearer).
constexpr bool F_PAIR_AMBUSH = true;
// Solo work is done alone: a dragon walking to or working a dead-end farm, inside a small enclosure (a portal chamber), in a
// portal loop, taking a portal or holding a guard post does not pair, and is not picked by a teammate (campers, residents
// and patch campers were already out).
// Measured (72 games vs v5.10, seeds 1111-1114, with F_PAIR_MUTUAL): 45 vs 45 wins, kills' net length +839 vs +1060
// without; the solo workers left unpaired drew more enemy strikes (687 vs 525 on unpaired dragons). Off.
constexpr bool F_PAIR_SOLO = false;
// Only 55% of links were mutual: a third dragon latched onto a pair. When another small teammate is nearer to our buddy
// than we are, and our buddy is its nearest, for PAIR_RIVAL turns in a row, our buddy is paired elsewhere: we let it go and
// do not pick it again for PAIR_BAN rounds.
// Measured with F_PAIR_SOLO (same games): mutual links 57% vs 56% without it (the usual case is a buddy that keeps a
// partner out of our view, which this cannot see). Off.
constexpr bool F_PAIR_MUTUAL = true; // v6 (F_V6_GROUP): on
constexpr int PAIR_RIVAL = 3, PAIR_BAN = 10;
// A fresh death drop (appeared this round or last) within DROP_FIRST_RANGE moves that we reach before every enemy head in
// view (and before every teammate in view), by turn order: eat it before splits, errands, pair pulls and exploration.
// (Traces of 314 enemy strikes on paired dragons: when the buddy was first to the drop, its next move went toward it only
// 43 times in 85; it split, dispersed or walked to its dead partner's spot.) Unlike v5.9c's F_COLLECT (hunters ate fresh
// drops first: worse, they walked into the enemy's strike zone), only a race we win counts.
// Measured (72 games vs v5.10, seeds 1111-1114): 38 vs 45 wins; it fired ~120 times a game, enemy strikes on us rose from
// 722 to 859 (net -962 vs -550 length), and the buddy's first move after its partner was struck still went toward the drop
// only 20 of 46 times (25 of 48 without). Rushing drops walks into the enemy's strike zone, as F_COLLECT did. Off.
constexpr bool F_DROP_FIRST = false;
constexpr int DROP_FIRST_RANGE = 3;
constexpr int REGROUP_TTL = 20;
// ---- v5.13 modules (M724704 brief, strategyV_5_13.md) ----
// 1 (F_FEED_PIPE): a feeder at its drop point splits into 3-long pieces before dying (ceil(3/2) = 2 pearls per 3 segments,
// against ceil(L/2) for the whole body). The parent keeps the front 3 and gives the rear L-3 to the child: the child gets a
// turn later this same round (IDs ascending) and splits again at once, so an L-long feeder is all pieces within one round
// (keeping the larger part in the parent would wait a round per split). A PIPE_TAG beam into the child says "you are a piece".
constexpr bool F_FEED_PIPE = true;
// 2 (F_EVADE): every single step leaves us where an enemy head can ram us at a profit (strike_risk, drop race included):
// sprint out of its reach before anything else, paying for extra steps with pearls on the way (len - (k - 1) + pearls >=
// EVADE_MIN_LEN, at most EVADE_MAX_COST segments net).
constexpr bool F_EVADE = true;
constexpr int EVADE_MAX_STEPS = 4, EVADE_MIN_LEN = 2, EVADE_MAX_COST = 2;
// 3 (F_CENSUS): enemies alive <= ID_max + 1 - our units (IDs are handed out in order to both teams). With at least
// AGGR_RATIO_X10 / 10 times their upper bound, the team goes aggressive (AGGR_TAG on sonar): exchange strikes down to
// AGGR_EXCH_MIN, rams without a collector, the kamikaze regime on.
constexpr bool F_CENSUS = true;
constexpr int AGGR_RATIO_X10 = 15, AGGR_MIN_UNITS = 5, AGGR_TTL = 20;
constexpr double AGGR_EXCH_MIN = -1.0;
// 3 (F_SCAVENGE): a dragon with no enemy near that will die next turn (a 2-long head left at a dead-end tip, a step into a
// pocket with no way on) calls teammates to its body the turn before (SCAV_TAG); callers within SCAV_RANGE go there first.
constexpr bool F_SCAVENGE = true;
constexpr int SCAV_RANGE = 8, SCAV_TTL = 6, SCAV_ENEMY_R = 5;
// 4 (F_FARM_RELAY, dilemma): keep one-way pearl corridors worked. A farm claim lapses FARM_CLAIM_TTL2 rounds after its
// worker leaves (was 30); a farm goal with no route is dropped; the rear child of a farm tip split (and any dragon whose
// last dive ended within FARM_KEEP_TTL rounds) goes back to the nearest free farm before any errand, pair or patrol.
constexpr bool F_FARM_RELAY = true;
constexpr int FARM_CLAIM_TTL2 = 10, FARM_CLAIM_RENEW = 4, FARM_KEEP_TTL = 30, FARM_KEEP_RANGE = 10;
// 5 (F_CENTER_PUSH, dilemma / devil): the wrap seam behind our half is kelp all along (as far as we have seen, and shared on
// the spawn beam): the enemy can only reach our half through the middle. Until PUSH_END, backline pearls (more than
// PUSH_BACK from the midline, on our side) are left for later and small dragons walk to the midline.
constexpr bool F_CENTER_PUSH = true;
constexpr int PUSH_END = 90, PUSH_SEEN_MIN = 6, PUSH_MID = 4; // patrol line: PUSH_MID tiles our side of the middle
constexpr int PIPE_TAG = 8177, AGGR_TAG = 8176, SCAV_TAG = 8175;

// v5.14 modules (the Sch_3 / Sch_4 / Dv_1 / Aut_11 / Aut_12 brief). Each can be switched off on its own.
// 1 (F_SPREAD, large maps): zone-based frontier exploration. The map is cut into zones of about 8x8. An idle dragon (nothing
// to eat in view) walks to the zone with the best mix of tiles it has never seen and pearls it expects there, against the
// walk (memory BFS, unknown tiles open) and against teammates: a zone a teammate claimed (ZONE_TAG) or explored (its
// "done" report) is worth much less. Replaces the fixed centre-relative waypoints, which kept whole teams in the first open
// corridor on Schooltime (rows 0-3) and on Devil's right quarter.
constexpr bool F_SPREAD = true;
constexpr int SPREAD_AREA = 900;                        // maps with at least this many tiles
constexpr int LARGE_AREA = 500;                         // F_SHARE / F_FRONT / F_RICH_CALL: maps with at least this many tiles
constexpr int ZONE_TAG = 8174, RICH_TAG = 8173, MAP_TAG = 8172;
constexpr int ZONE_EXPLORED_PCT = 55;                   // a zone we have seen this much of is explored (shared on MAP_TAG)
// F_SEAM_MEM: a map-border seam whose every seen edge is kelp (6 or more) is taken as kelp all along by the memory BFS
// (Schooltime's top/bottom seam: routes to the far side went through the unseen part of it).
constexpr bool F_SEAM_MEM = true;
// F_SPREAD_PORTAL: a portal whose far end we have never seen is an exploration goal worth SPREAD_PORTAL_VALUE (a zone of
// unseen tiles is worth up to ~80). On Schooltime the enemy spread through its twelve cross-map portals.
constexpr bool F_SPREAD_PORTAL = true;
constexpr double SPREAD_PORTAL_VALUE = 60.0;
constexpr int ZONE_CLAIM_TTL = 18, ZONE_DONE_TTL = 50, ZONE_RICH_TTL = 40, MAX_ZONES = 64;
constexpr double ZONE_W_UNSEEN = 1.0, ZONE_W_PEARL = 6.0, ZONE_W_DIST = 0.4, ZONE_CLAIM_PEN = 45.0, ZONE_FRIEND_PEN = 14.0;
constexpr double ZONE_ENEMY_PEN = 12.0, ZONE_KEEP = 12.0, ZONE_W_SPAWN = 1.5; // a known spawner tile (ours or mirrored)
constexpr int ZONE_STALL = 12, ZONE_BAN = 25, ZONE_NEWBORN = 2; // ...and a newborn waits ZONE_NEWBORN rounds for the map gossip  // a zone goal whose route does not shorten for ZONE_STALL turns is dropped
// Claims repel: a zone within ZONE_REPEL_R tiles of a zone a teammate claimed loses up to ZONE_REPEL_W (linear in distance),
// so the team's goals fan out over the map instead of growing out of the spawn as one blob.
constexpr double ZONE_REPEL_W = 35.0, ZONE_REPEL_R = 20.0; // v6 (item 5): was 25, 16
// 2 (F_RICH_CALL): a dragon that sees a pile of pearls it cannot eat alone (RICH_MIN or more in view, fewer than one
// teammate per RICH_PER pearls there) calls it on RICH_TAG with the count; receivers add it to that zone's value, so the
// nearest idle explorers turn toward it (a zone takes up to 1 + pearls / RICH_PER dragons before the crowd penalty bites).
constexpr bool F_RICH_CALL = true;
constexpr int RICH_MIN = 6, RICH_PER = 4, RICH_GAP = 6;
// 3 (F_SHARE, Dv_1 round 13): early on a large map with no enemy in view and few pearls around, a pearl that lies between us
// and a teammate's head close to it is that teammate's: it is already working that stretch and nobody can steal the pearl.
// We leave it and go on exploring (ID 13 turned into the dead-end column ID 1 was sweeping, for one pearl).
constexpr bool F_SHARE = true;
constexpr int SHARE_END = 150, SHARE_MAX_PEARLS = 3, SHARE_R = 3, SHARE_MIN_UNITS = 4; // with fewer units each one eats what it finds
// 4 (F_FRONT, Aut_11 / Aut_12): maps split in two halves by a closed wrap seam (autarky, devil, dilemma, stronghold, trauma).
// Our half is the side of the midline our team spawned on (the centroid of the spawns we heard). Enemy heads seen FRONT_DEEP
// or more tiles into our half are intruders; sightings go round on FRONT_TAG. Posture:
//  - hold (FRONT_HOLD_N intruders at once, or two sightings within FRONT_PAIR rounds; for FRONT_HOLD_TTL rounds): idle hunters
//    (kamikaze, sprint hunters, skirmishers) take zones in the front band on our side, first where intruders were seen;
//    foragers keep out of the enemy half.
//  - push (no intruder for FRONT_QUIET rounds, round >= FRONT_PUSH_MIN, and aggression mode or FRONT_PUSH_X10 / 10 times the
//    enemy's census bound): idle hunters take zones in the enemy half, nearest the midline first, spread over the whole front
//    by the zone claims (a wave, not one lane); foragers are unchanged (the reserve at home).
constexpr bool F_FRONT = true;
constexpr int FRONT_TAG = 8171, FRONT_DEEP = 3, FRONT_HOLD_N = 2, FRONT_PAIR = 10, FRONT_HOLD_TTL = 20, FRONT_QUIET = 25;
constexpr int FRONT_PUSH_MIN = 40, FRONT_PUSH_X10 = 13, FRONT_BAND = 5;
constexpr bool FRONT_HOLD_FORAGERS = true; // in hold, foragers keep out of the enemy half (the hunters' part is separate)
// 5 (F_APEX_SEEK, battle M746645: Slithery ended with 8 alphas of 11-72 and Portals with 4, never merged; the enemy won with
// one 95-long dragon). From the feed round, a sighting of a teammate alpha up to APEX_TTL rounds old (was SONAR_TTL, 36)
// still counts for feeding, scored APEX_AGE_W lower per round of age: feeders only die with the apex in view, so walking to
// an old sighting costs nothing. A sighting whose spot we reach without the alpha in view is forgotten.
constexpr bool F_APEX_SEEK = true;
constexpr int APEX_TTL = 100;
constexpr double APEX_AGE_W = 0.5;
// 6 (F_QUIET_END): the v5.14 broadcasts (explored map, zone claims, rich calls, front) stop FEED_QUIET rounds before the
// feed round, and rich calls go out only on maps the zone planner uses: every extra packet takes a beam that would carry
// an alpha's position, which is what feeders and small alphas need at the end.
constexpr bool F_QUIET_END = true;
constexpr int FEED_QUIET = 20;
// 7 (F_APEX_ROOM, M746648 Portals: our 27-long apex was walled into a corner by ~15 of our own small dragons and made seven
// rescue splits in a row): a small dragon (<= APEX_ROOM_SMALL) that is not feeding does not step within 2 (Chebyshev) of the
// head of a teammate at least APEX_ROOM_LEN long, unless that brings it no closer or there is a pearl on the tile.
constexpr bool F_APEX_ROOM = true;
// 7b (F_APEX_VIEW, slithery seed 1191: 30 dragons were alphas at the feed round and the apex's ID changed with every rescue or
// handover split, so feeding by tracked ID left 5-8 alphas of 28-38 foraging beside a 55-long one): from the feed round a
// teammate in view APEX_VIEW_MIN or more long and 2 or more longer than us is a feed target whatever we know of its ID, with
// APEX_VIEW_BONUS for being in view (a real body, not a sonar report).
constexpr bool F_APEX_VIEW = false; // no gain measured (r11 25 vs 27 of 44; r14 with gossip 14 vs 18 of 28)
constexpr int APEX_VIEW_MIN = 8;
constexpr double APEX_VIEW_BONUS = 20.0;
// 7c (F_APEX_GOSSIP, same games; worse with F_UNIT64's extra units): the team agrees on the apex by length, not by ID. Every
// dragon keeps the longest apex report it knows (position, length, round: itself, a teammate in view, or APEX_TAG) and relays
// it; a report is replaced by a longer one, or by any fresher one once it is APEX_STALE rounds old. From APEX_LEAD rounds
// before the feed round a dragon (alpha or not) whose report is APEX_MARGIN or more longer than itself walks toward it, and
// feeds the first clearly longer teammate it sees (F_APEX_VIEW). A sighting reached with nobody there is dropped.
// 7d (F_EARLY_FEED_IDLE, autarky vs v5.12: F_EARLY_FEED made pocket workers on our closed half "calm" and they fed from round
// 250; by round 400 we were one dragon eating 6 pearls in 50 rounds against 35 enemy units eating 54): feeding before the
// feed round also needs EARLY_IDLE rounds without food, so only idle dragons consolidate early.
constexpr bool F_EARLY_FEED_IDLE = true;
constexpr int EARLY_IDLE = 30;
// 7e (F_FEED_LONGEST): feeders weigh the alpha's length twice as much against the walk (8 L - k, was 4 L - k), so mass goes
// to the longest alpha rather than to a nearer mid-sized one (each relay loses half: slithery ended with 5-8 alphas).
// 7f (F_ALPHA_STRICT): about 30 dragons carry the alpha role at the feed round (slithery, schooltime), because every split
// child of 4 or more became an alpha (F_HANDOVER). Alphas only feed an alpha they know to be longer; others feed any alpha.
// Now a split child takes the role only at ALPHA_CHILD_MIN or longer: shorter ones stay ordinary dragons and feed.
constexpr bool F_ALPHA_STRICT = false; // r17: alphas unchanged (schooltime 9.5, slithery 7.2), 10/20 vs 13/20
constexpr int ALPHA_CHILD_MIN = 10;
constexpr bool F_FEED_LONGEST = false; // r17: 12/28 with it vs 16/28 without (idle gate on)
constexpr bool F_APEX_GOSSIP = false; // r14: engaged (1397 feed picks) but 14/28 vs 18/28, alphas unchanged
constexpr int APEX_TAG = 8170, APEX_STALE = 25, APEX_LEAD = 40, APEX_MARGIN = 2;
constexpr int APEX_ROOM_LEN = 10, APEX_ROOM_SMALL = 6;
constexpr double APEX_ROOM_W = 45.0;
// 8 (F_TRADE_GATE, M746654 Trophy round 24: a 3-for-3 exchange strike with 3 units against 5): while our team has
// TRADE_SMALL_TEAM units or fewer (and no aggression mode), an exchange strike needs a body gain (the enemy longer than we
// are when we hit it), not just a good drop race: every unit is a growth engine a small team cannot replace.
constexpr bool F_TRADE_GATE = true;
// 9 (F_CHOKE_CAMP, autarky on the ladder: the enemy ate 96 dead-end pocket pearls per 100 rounds to our 24; we never
// entered its two pockets and it took ours from round 40-57): camp the mouths of dead-end farms with the F_GUARD machinery
// (a small dragon circles the 2x2 block through the tile the farm's corridor comes out onto, so a diver's rear child
// cannot get out; when the farm is empty and refilled the dead-end rules dive it).
//  - defend: a farm on our side (or on a map without halves) with an enemy head inside it (seen from anywhere in view);
//  - raid: from CAMP_RAID_START, every farm on the enemy half (our farms' mirror images, F_FARM), for as long as it is known.
// Camp posts are taken from up to CAMP_RANGE moves away (other guard posts: GUARD_RANGE) and flagged on GUARD_TAG (bit 6).
constexpr bool F_CHOKE_CAMP = true;
constexpr int CAMP_RANGE = 24, CAMP_RAID_START = 30, CAMP_TTL = 30, CAMP_NEAR = 2;
// Raiders are spare dragons: not one working a pocket (pocket loop, farm keeper), and only with CAMP_RAID_UNITS units or more
// (raiders taken from our own pocket workers cost us 193 -> 162 pearls a game in our own pockets against v5.12).
constexpr int CAMP_RAID_UNITS = 10;
constexpr bool CAMP_DEFEND = true, CAMP_RAID = false; // raid off: vs v5.12 it cost 18 pearls a game in our own pockets for no gain in theirs (8 games)
constexpr int TRADE_SMALL_TEAM = 4;
// ---- v5.14a modules (brief of 2026-10-01: M739447 autarky, Slt_fgt, Def_1..5, trophy1; strategyV_5_14a.md) ----
// 2 (F_UNIT64, Slt_fgt): the non-alpha split cap is the engine's unit limit less SPLIT_CAP_MARGIN, not UNIT_CAP (33).
constexpr bool F_UNIT64 = true;
constexpr int SPLIT_CAP_MARGIN = 4;
// 1 (F_POCKET_LOOP, M739447 autarky dragon 42, rounds 30-55): autarky has four 4-tile dead-end pockets (the map does not
// wrap in y) with three spawners each that refill every round or two. They sat full and unworked in 2.1 of 4 pockets at
// any time (ladder and self-play alike). Each dive is made by a different dragon: the rear child of a tip split walked off
// (dispersal, pairs, ambushes; an alpha child got the mantle and left), only 24 of 83 went back within 20 rounds. Now a
// dragon born with its tail in a paying dead end (LP_MIN_LIVE pearls live, at most LP_MAX_SIZE tiles) routes back to that
// tail tile for LP_TTL rounds (out, round and back in, since it cannot turn), and the dead-end cooldown does not apply.
// 4 (F_DECLUMP, trophy1: we took the cup first, then 71% of our head-rounds were in it (2% in the handles) while the enemy
// worked the handles and the open ring and ate 153 to our 73 in rounds 50-150): see the F_DECLUMP block in decide_core.
// Only where the wrap seam behind our half is open (not devil / dilemma, where F_CENTER_PUSH holds the middle) and no
// border edge we know of is kelp (autarky: it cut the pocket loops).
constexpr bool F_DECLUMP = true;
constexpr int DECLUMP_START = 30, DECLUMP_R = 3, DECLUMP_CROWD = 3, DECLUMP_SHUN = 30, DECLUMP_LEAVE_R = 8;
// ---- v6 modules (the 2026-10-01 v6 brief). Each can be switched off on its own. ----
// 1 (F_V6_GROUP): pairs are mutual (F_PAIR_MUTUAL on) and move in formation: the lower ID leads (the striker), the higher
// ID keeps a tile beside or behind it (the collector, off the striker's line so a strike's drop is 1-2 moves away). Three
// or more small teammates within V6_GROUP_R form a group: cohesion toward the group's centre, and with an enemy head near
// that we outnumber, the member nearest it strikes (pair hunt, no "lone enemy" rule) while the others take flank spots on
// both sides of its path (V6_FLANK_OFF tiles off). Declump does not break up groups.
constexpr bool F_V6_GROUP = true;
constexpr int V6_GROUP_R = 4, V6_FLANK_OFF = 2, V6_FLANK_RANGE = 6;
constexpr double V6_GROUP_W = 10.0;
// 5 (part of F_V6_GROUP): on big maps (more than PAIR_AREA tiles) pairs and groups form only once the team has
// V6_BIG_UNITS units; groups there keep to at most V6_BIG_GROUP_MAX members (small groups; the rest spread by F_SPREAD).
constexpr int V6_BIG_UNITS = 50, V6_BIG_GROUP_MAX = 3;
// 2 (F_V6_CLOSE, dilemma): an enemy head within V6_CLOSE_R of us by round V6_CLOSE_DETECT on a small map: the spawns are
// close. Pairs and groups form at once (no PAIR_START / PAIR_MIN_UNITS) and small dragons keep with the group (the alpha
// counts as a member to protect) until we dominate the region: V6_DOM_TURNS turns in a row with no enemy head in view, or
// V6_DOM_MARGIN more of our heads than theirs in view, from round 15; at the latest V6_CLOSE_END.
constexpr bool F_V6_CLOSE = true;
constexpr int V6_CLOSE_R = 9, V6_CLOSE_DETECT = 12, V6_CLOSE_TTL = 30, V6_CLOSE_END = 120, V6_DOM_TURNS = 10, V6_DOM_MARGIN = 2;
// 3 (F_V6_PUSH, devil / dilemma): behind a closed wrap seam the enemy can only reach our half through the middle. The centre
// push (F_CENTER_PUSH) also takes the alpha for the first V6_ALPHA_PUSH_END rounds (to a line V6_ALPHA_BACK tiles behind the
// patrol line), and lasts past PUSH_END until the centre is secured (no intruder for V6_SECURE_QUIET rounds, from round
// V6_SECURE_MIN), at the latest V6_PUSH_END: backline pearls stay banked until then.
constexpr bool F_V6_PUSH = true;
constexpr int V6_ALPHA_PUSH_END = 40, V6_ALPHA_BACK = 3, V6_PUSH_END = 140, V6_SECURE_MIN = 70, V6_SECURE_QUIET = 30;
// 4 (F_V6_DENY_SPRINT): a pearl in view that an enemy head reaches before any of us walking, but that we reach this turn
// by a sprint with net length >= 0 (pearls on the way pay for the extra steps; the enemy is denied the pearl: +1 relative
// at least): sprint there, if the landing tile is not one an enemy head can ram at a profit.
constexpr bool F_V6_DENY_SPRINT = true;
constexpr int V6_DENY_MAX_STEPS = 5;
// 3 (F_POOR_CHAMBER, Def_1..5: we lost 4 of 5; in Def_5 88% of our head-rounds were in the central portal rooms, which
// pay ~0.04 pearls a round each, while the enemy ate 57-73% of its pearls on open ground): see portal_target().
constexpr bool F_POOR_CHAMBER = true;
constexpr int POOR_UNKNOWN = 2; // tiles of the chamber we may not know the timer of
constexpr bool F_POCKET_LOOP = true;
constexpr int LP_MIN_LIVE = 3, LP_MAX_SIZE = 12, LP_TTL = 40, LP_RANGE = 20, LP_MAX_LEN = 12;
constexpr int HAZARD_TTL = 12, RESERVE_TTL = 30, SMALL_ENCLOSURE = 20;
constexpr int MAX_HAZARDS = 8, MAX_PEARL_MEM = 16;

// ---- v7 modules (the 2026-10-02 queen brief, strategyV_7.md). Each can be switched off on its own. ----
// The rules changed twice. At round 500 the queens' lengths are compared first (the queen is dragon 0 for team A, dragon
// 1 for team B; a dead queen counts 0), then the longest dragon, then the total. And a dragon L long takes ceil(L / 4)
// steps a turn for free; each step beyond costs a segment.
//
// F_SPRINT_V2: sprint costs by the new rule, for our own sprints and for the reach of enemy heads.
constexpr bool F_SPRINT_V2 = true;
// F_FREE_STRIDE: a dragon with two or more free steps (5+ long) spends them: on a pearl beside the tile it lands on, else
// along the route to this turn's target (the queen: pearls only, and distance from an enemy head, see F_QUEEN_FLEE).
constexpr bool F_FREE_STRIDE = true;

// F_QUEEN: the queen keeps the body that carries its ID. A split leaves the front part with the parent, so every L-2 split
// of v6 (round-0 cascade, rescue, threat, portal sacrifice, handover) left the queen's ID on a 2-long skirmisher: in v6
// self-play it was dead by round 500 in 12 of 16 games (median round 46). Under the queen rules the dragon makes none of
// those, never hands its role on, never strikes, and is the one dragon the team feeds.
constexpr bool F_QUEEN_ALL = true; // (v7.1: Brain::F_QUEEN is this, off on small maps when F_V71_SMALL_V6)
// Maps of up to QUEEN_SMALL_AREA tiles are "small" (portals 512, trophy 625); above, medium / large.
constexpr int QUEEN_SMALL_AREA = 700;
// F_QUEEN_LIGHT (2.A, "high-risk pathing"): where the game is decided by elimination the body's mass and every unit's
// fighting count for more than the ID. On a small map, and on a medium / large one with close spawns (an enemy head with
// a way to the queen of at most QUEEN_SAFE_DEPTH moves in QUEEN_CLOSE_ROUNDS of the first QUEEN_CLOSE_ROUND rounds:
// default, where the queens start next to each other across the wrap seam), the dragon with the queen's ID plays exactly
// as in v6 (cascade, L-2 splits, strikes, portals) until the safe state (F_QUEEN_SAFE) switches the queen rules on for
// good. With the queen rules from round 0 there (even reduced to "no L-2 split, no strike, keep out of reach") v7 won 2 of
// 18 games against v6 on devil, dilemma and stripes; in this mode 8-9 (parity). What applies to the ID from round 0: no
// feeding of another dragon, no ram on the enemy queen (both queens gone leaves the longest dragon to decide), no small
// chamber (F_QUEEN_NOCAMP), and the teammates' sacrifice (F_QUEEN_SAC).
constexpr bool F_QUEEN_LIGHT = true;
constexpr int QUEEN_CLOSE_ROUND = 12, QUEEN_CLOSE_ROUNDS = 3;
// F_QUEEN_SAFE (2.A): reachability. An enemy head counts when its way to the queen over the remembered map (portals we
// know both ends of included, unseen ground open) is at most QUEEN_SAFE_DEPTH moves. QUEEN_SAFE_QUIET rounds without one,
// from round QUEEN_SAFE_MIN, with the opening economy done (QUEEN_SAFE_UNITS units) or with evidence (enemy heads in view
// for QUEEN_SAFE_WALLED rounds that had no way to the queen: portals, where they sit behind kelp from round 4): nobody
// contests our side, and the queen goes over to growth and consolidation: the queen rules and the zero-risk rules.
// (An empty view is no evidence: on trophy nobody had arrived by round 14, and a queen that stopped splitting then was
// half the opening economy: 0 of 4.) On a medium / large map it also says so in its heartbeat (flag bit 0), and teammates
// that hear it may start feeding from QUEEN_CONSOL_FEED (calm for QUEEN_CONSOL_PEACE rounds), not EARLY_FEED_ROUND.
constexpr bool F_QUEEN_SAFE = true;
constexpr int QUEEN_SAFE_MIN = 14, QUEEN_SAFE_QUIET = 14, QUEEN_SAFE_DEPTH = 10, QUEEN_SAFE_UNITS = 10, QUEEN_SAFE_WALLED = 5;
constexpr int QUEEN_CONSOL_FEED = 180, QUEEN_CONSOL_PEACE = 80;
// F_QUEEN_NOCAMP (2.A): the queen's ID walks into no small portal chamber and leaves one on the first turn it can, once
// the team has QUEEN_NOCAMP_UNITS units to leave the chambers to. (Stripes: two 2-long spawns a team and every pearl of
// the map inside portal chambers; kept out of them from round 0 the queen was half the team not eating: 0 of 6.)
constexpr bool F_QUEEN_NOCAMP = true;
constexpr int QUEEN_NOCAMP_UNITS = 6;
// F_QUEEN_SAC (2.A): the queen's head has no free tile to step to and one of our segments is on a tile it could step to:
// we die at once, whatever our length, in any round. (The first version also fired for a small pocket in front of the
// head: a long queen following its own tail always has one, and its escorts died within a round of being named, 15
// times a game on stronghold.) The queen itself, with no move that lives, splits instead: a split is the one action
// that leaves the head where it is, and whoever boxes it in acts later in the same round. With a teammate beside the
// head it sheds 2 and waits; boxed in by its own coils it cuts the body at the coil beside the head that is nearest the
// tail ("unwind": that segment becomes the child's tail, the first tile the child leaves). It also waits one turn when
// every way on has room for under QUEEN_WAIT_ROOM tiles and a teammate's body is beside its head.
// Nobody steps within one tile (Chebyshev) of an active queen's head or onto the two tiles in front of it (QUEEN_CLEAR_W),
// and teammates that are neither escorts nor feeding keep QUEEN_ZONE_R from it (three times as strongly from
// QUEEN_ZONE_LONG long: a long body is a wall) and leave it the pearls it is as near to. One unit slot of the 64 is kept
// free at all times, so that the queen can always split.
constexpr bool F_QUEEN_SAC = true;
constexpr int QUEEN_WAIT_ROOM = 4, QUEEN_ZONE_R = 3, QUEEN_ZONE_LONG = 7;
constexpr double QUEEN_CLEAR_W = 300.0, QUEEN_ZONE_W = 30.0;

// The queen's children on a medium / large map. A long spawn body (QUEEN_CASCADE_MIN or more: slithery_fight, 25) keeps
// QUEEN_KEEP_START in round 0 and gives the rest to the cascade. Where the queen is a third of the team or more at the
// start (QUEEN_BROOD_SPAWNS spawn dragons or fewer) it broods: while the team has fewer than QUEEN_BROOD_UNITS units
// (until QUEEN_BROOD_END, and not with an enemy head in reach of it in the last QUEEN_BROOD_QUIET rounds) it takes part in
// the round-0 cascade and sheds 2 at length 4, as v6's alpha does, and moves by the alpha's rules. (Without the brood,
// queen_of_spades had 4 units against 8 by round 50 and was lost by elimination twice; with a brood on islands, five
// spawns, the queen was 2 long with no pearl in reach and was chased at walking pace from round 60.)
constexpr int QUEEN_CASCADE_MIN = 11, QUEEN_KEEP_START = 9;
constexpr int QUEEN_BROOD_SPAWNS = 3, QUEEN_BROOD_UNITS = 8, QUEEN_BROOD_END = 40, QUEEN_BROOD_QUIET = 10;

// F_QUEEN_BEAT (3.A): the queen sends its position, length, escort roster and flags on all four beams every turn
// (QUEEN_TAG; on a small map v6's own alpha packet, which also carries the kamikaze regime the fight runs on). Every
// teammate relays the freshest report it has on QUEEN_RELAY_BEAMS beams a turn and on every beam it has no other use
// for. With no report for QUEEN_TIMEOUT_TICKS rounds (the map's width + height where that is more: a report crosses
// a 64 x 64 map by hops) a dragon takes the queen for dead and plays v6 (alphas by length, the apex fed). A death is
// also learnt at first hand: a teammate that had the queen's head in view sees a pearl where it was and reports "dead"
// (a queen packet with length 0) on every beam; a dragon that reaches the reported position and finds no queen drops
// the report.
constexpr bool F_QUEEN_BEAT = true;
constexpr int QUEEN_TIMEOUT_TICKS = 60, QUEEN_RELAY_BEAMS = 2;

// F_QUEEN_ZERO (2.B): medium / large maps after the brood (and small ones in the safe state): the queen takes no portal,
// enters no corridor (a tile with at most two open edges; off on a map made of corridors) and no crowd (QZ_CROWD a
// segment beyond QZ_CROWD_FREE within QZ_CROWD_R), prefers room (QZ_SPACE), keeps QZ_ENEMY_R from enemy heads in view,
// leaves a pearl an enemy head is within its own distance + QZ_CONTEST of, and stays home: QZ_HOME_W a tile beyond the
// home radius (the map's mean side / 4, at least 6) from its spawn, QZ_FAR_SIDE on the enemy's side of the map, pearls
// only up to QZ_HOME_FOOD beyond the radius, and with nothing to eat it walks back. (Autarky: following a remembered
// pearl inside a pocket it could not enter, the queen circled 15-20 tiles from home among the enemy's hunters.)
constexpr bool F_QUEEN_ZERO = true;
constexpr double QZ_CORRIDOR = 320.0, QZ_CROWD = 14.0, QZ_SPACE = 1.5, QZ_ENEMY_W = 25.0, QZ_HOME_W = 30.0, QZ_FAR_SIDE = 250.0;
constexpr int QZ_SPACE_CAP = 30, QZ_CROWD_R = 2, QZ_CROWD_FREE = 2, QZ_ENEMY_R = 7, QZ_CONTEST = 2, QZ_HOME_FOOD = 3;
constexpr int QZ_CORR_MIN_SEEN = 40;
// Under the queen rules on every map: the queen never ends a turn on a tile an enemy head in view can step or sprint
// onto this round (QZ_EXPOSED, less 250 a step the enemy needs: among tiles all in reach, the dearest for it; a body
// that runs out of view counts 12 long), nor near where an enemy head was seen in the last GHOST_TTL rounds
// (QUEEN_GHOST_REACH + a tile a round, QUEEN_GHOST_W). It steps into no region it cannot prove leads on (QUEEN_ALLEY:
// unseen tiles count as walls, and a portal it may not take is no way on), and keeps room for its whole body
// (QUEEN_ROOM_W a tile short, up to QUEEN_ROOM_CAP), on the direct pearl path too. The room check is strict for the
// queen: unseen ground is a wall, the whole tracked body frees on time (in view or not), and every pearl on the ground
// searched delays the coils by a move (a pearl eaten keeps the tail still).
constexpr double QZ_EXPOSED = 2500.0, QUEEN_GHOST_W = 400.0, QUEEN_ALLEY = 900.0, QUEEN_ROOM_W = 60.0;
constexpr int QUEEN_GHOST_REACH = 4, QUEEN_ROOM_CAP_V7 = 60;
// v7.5 (F_V75_QROOM, stronghold: a 107-long queen in its 264-tile sealed half coiled round its own head, had no move that
// lived, and its unwind split gave 100 segments to a child; 5 of 8 games, children of 19-100): the queen's room test asks
// for room for its whole body (up to QUEEN_ROOM_CAP_V75), not at most 60 tiles.
constexpr bool F_V75_QROOM = true;
constexpr int QUEEN_ROOM_CAP_V75 = 220;
constexpr int QUEEN_ROOM_CAP = F_V75_QROOM ? QUEEN_ROOM_CAP_V75 : QUEEN_ROOM_CAP_V7;
// F_QUEEN_SURGE (3.D): no single step ends out of every enemy's reach: the cheapest sprint that does (free steps first,
// pearls on the way pay, at most QUEEN_SURGE_COST segments, never below QUEEN_SURGE_MIN_LEN).
// F_QUEEN_FLEE (3.D): with an enemy head within QUEEN_FLEE_R the queen spends its free steps on distance.
constexpr bool F_QUEEN_SURGE = true, F_QUEEN_FLEE = true;
constexpr int QUEEN_SURGE_STEPS = 6, QUEEN_SURGE_COST = 3, QUEEN_SURGE_MIN_LEN = 2, QUEEN_FLEE_R = 6;
// A queen in a sealed cell of the map (schooltime: both queens start in a walled 2x2 with no portal) can be neither fed,
// escorted nor hunted. It says so in its heartbeat (flag bit 1); the team plays for the next tiebreak, the longest
// dragon, as v6 does, and sends no hunters (the enemy queen is in the mirror image of that cell).
constexpr int QUEEN_CAGE_MAX = 20;
// F_QUEEN_RATION (medium / large maps): a queen under QUEEN_RATION_LEN (three free steps a turn at 9) is fed during the
// game: of the dragons 3 or more long within RATION_RANGE of its reported position, the RATION_SHARE_X100 / 100 picked by
// the hash of their ID walk to it without splitting and drop their pearls beside it, from RATION_MIN_UNITS units.
constexpr bool F_QUEEN_RATION = true;
constexpr int QUEEN_RATION_LEN = 9, RATION_RANGE = 12, RATION_MIN_UNITS = 10, RATION_SHARE_X100 = 34;
// F_QUEEN_GUARD_END: from the feed round, every small dragon with the queen in view defends it as an escort does (the
// pearls feeders drop round the queen pay for enemy sprints: maze round 493, a 2-long enemy took one and a 60-long
// queen's head).
constexpr bool F_QUEEN_GUARD_END = true;

// ESCORT_ARCH (3.B / 4.B), medium / large maps, from MIN_ESCORT_POPULATION units:
//  1  proximity (strat 1): no roster. A small dragon within ESCORT_ZONE moves of the queen's reported position (out to
//     ESCORT_ZONE_KEEP once on duty), with fewer than the team size of small teammates in view nearer to it, is a
//     defender for as long as that holds.
//  2  fixed (strat 2): the queen names its escorts (the nearest small teammates in its view that hold no ranger slot and
//     no ration duty) in the heartbeat; they follow it across the map. One unseen for ESCORT_LOST rounds is replaced by
//     the nearest unassigned teammate in view, and short of ESCORT_MIN for ESCORT_SPLIT_WAIT rounds a queen of
//     QUEEN_ESCORT_SPLIT_LEN or more splits one off its own tail. The roster reaches an escort on a beam that happens to
//     end on it, so a dragon also takes the duty by the queen's own count from its side (the queen's head within 3,
//     fewer than the team size of small teammates nearer), and keeps it ESCORT_LATCH rounds after the last sign.
//  3  hybrid: ESCORT_HYBRID_FIXED named escorts, the rest of the team size by proximity.
// The team is ESCORT_TEAM_SMALL strong, ESCORT_TEAM_BIG from ESCORT_BIG_UNITS units. Escorts keep ESCORT_NEAR..ESCORT_FAR
// (Chebyshev) from where the queen's head will be next turn, off its line ahead, with ESCORT_ROOM tiles of free ground of
// their own; leave it the pearls it is as near to; do not split below ESCORT_SPLIT_LEN; stay on duty until
// ESCORT_FEED_ROUND; and intercept: the nearest of them to an enemy head within ESCORT_THREAT_R moves of the queen rams it
// when it can reach it this turn (a sprint included), else steps between the two.
// A/B against v6 (bench7/ab, 10 medium / large maps, both sides; stage A with ranger quotas, stage F with waves on the
// final code; 40 games a build): wins 30 with no escorts, 25 proximity, 31 fixed, 32 hybrid; the queen alive at the end
// in 27, 23, 26, 26. In stage F its mean final length (0 when dead) was 36.0 with no escorts against 23.2, 26.9, 27.4:
// escorts hold 2-4 dragons back from the feed until round 470 and cost the queen a split per replacement. Against the
// v7 build with no escorts (12 games each): 4, 5, 4 wins. What the escorts do: 4.0 / 2.7 / 3.6 on duty a round, 39% /
// 46% / 41% of their turns at 2-3 tiles from the queen's head, 62 / 26 / 52 head-on interceptions in 20 games, a gap
// refilled in 10-14 rounds. Of the three architectures fixed keeps its station best and proximity does worst on every
// count; none of them keeps the queen alive more often than no escorts at all, so 0 is shipped (2 is the one to try
// first against an opponent that hunts the queen with short dragons).
constexpr int ESCORT_ARCH = 4; // v7.1: 4 = havens (F_V71_HAVEN; with it off, as 0)
constexpr int MIN_ESCORT_POPULATION = 10, ESCORT_TEAM_SMALL = 2, ESCORT_TEAM_BIG = 3, ESCORT_BIG_UNITS = 16, ESCORT_MIN = 2;
constexpr int ESCORT_NEAR = 2, ESCORT_FAR = 3, ESCORT_ZONE = 8, ESCORT_ZONE_KEEP = 11, ESCORT_MAX_LEN = 6, ESCORT_SPLIT_LEN = 6;
constexpr int ESCORT_LOST = 15, ESCORT_SPLIT_WAIT = 6, QUEEN_ESCORT_SPLIT_LEN = 8, ESCORT_THREAT_R = 6, ESCORT_HYBRID_FIXED = 1;
constexpr int ESCORT_LATCH = 8, ESCORT_ROOM = 8, ESCORT_FEED_ROUND = 470;
constexpr double ESCORT_W = 30.0;
// MACRO (3.C / 4.A), medium / large maps:
//  0  no hunters by role (the regicide rule below still holds).
//  1  waves (strat 1): everybody farms the pearl clusters and multiplies (the v6 economy); from WAVE_START, every
//     WAVE_PERIOD rounds, the WAVE_RATIO_X100 / 100 of the team picked by a hash of the ID attack for WAVE_LEN rounds on
//     WAVE_FRONTS lanes across the enemy half (the mirror image of our spawns), and converge on the enemy queen once it
//     is reported.
//  2  quotas (strat 2): a ranger squad of RANGER_SQUAD from RANGER_MIN_POP units (less while the team has under
//     RANGER_RESERVE others), in RANGER_SLOTS slots of two: the four quadrants and the enemy queen's side. Rangers grow
//     to RANGER_MIN_LEN (two free steps a turn), split only at RANGER_MIN_LEN + 2, go to the enemy queen's likely home
//     first (the mirror image of where our queen is, each slot RANGER_HOME_R to its own side), then sweep their quadrant;
//     the two of a slot travel together.
//  3  hybrid: the ranger squad is a quarter of the team (2 to RANGER_SQUAD), and once the enemy queen is reported the
//     wave share of the team within EQ_WAVE_R of the report joins the hunt.
// F_REGICIDE, in every mode: a dragon other than the queen that can reach the enemy queen's head this turn (one step, or
// a sprint over free tiles) rams it: queens move first, so it is still there. A dragon that sees it reports it on every
// beam (EQ_TAG), and everyone relays the freshest report for EQ_TTL rounds; a ranger with no way to its head closes on
// its flank. (On a small map before the safe state: only at most REGICIDE_SMALL_LEN long and 2 steps, or from
// REGICIDE_SMALL_ROUND; and no reports: the beams are needed for the fight.)
// A/B against v6 (bench7/ab, stages A, A2 and F, fixed escorts, 60 games a build, hybrid 40): no hunters 49 wins, waves
// 46, quotas 45, hybrid 27 of 40. v6 loses its queen on its own (median round 79, dead by round 500 in 19 games of 20):
// there is nothing to hunt, and hunters are dragons not farming. Against the v7 build without hunters, whose queen is
// protected (12 games each): waves 8, quotas 6 (5 after RANGER_HOME_R), hybrid 3 (4). Enemy queens taken in those 36
// games: 15, 13 of them by ordinary dragons under the regicide rule, 2 by wave dragons, none by rangers (1 after
// RANGER_HOME_R); the squad averaged 5 rangers a round, a fifth of them 5 long. Waves are shipped: the best of the three
// against a protected queen, at the least cost against v6 (with no escorts: 16 of 20 with waves and without).
constexpr int MACRO = 1;
constexpr int RANGER_SQUAD = 10, RANGER_RESERVE = 20, RANGER_MIN_POP = 24, RANGER_MIN_LEN = 5, RANGER_SLOTS = 5;
constexpr int WAVE_START = 60, WAVE_PERIOD = 100, WAVE_LEN = 70, WAVE_RATIO_X100 = 40, WAVE_MIN_POP = 12, WAVE_FRONTS = 3;
constexpr int EQ_TTL = 25, EQ_WAVE_R = 18, RANGER_WP_TTL = 40, RANGER_HOME_R = 5;
constexpr bool F_REGICIDE = true;
constexpr int REGICIDE_SMALL_LEN = 3, REGICIDE_SMALL_ROUND = 300;
// Sonar: the queen's heartbeat and the enemy queen report have their own layout below the position and length fields
// (heartbeat: three roster slots of 6 bits (ID % 63, 63: none), flags: bit 0 safe, bit 1 sealed in; enemy queen: bit 0
// dead), so they are decoded before the generic fields are read.
constexpr int QUEEN_TAG = 8169, EQ_TAG = 8168;

// ---- v7.1 modules (brief of 2026-10-03, strategyV_7_1.md). Each can be switched off on its own. ----
// F_V71_SMALL_V6 (item 3): on a small map (QUEEN_SMALL_AREA tiles or fewer) the game is won by elimination: play v6.
// No queen rules, no queen ID at all (F_QUEEN is off for the game), no regicide, rangers or escorts; the dragon that
// holds the queen's ID cascades, splits, takes portals and dies like any other. (The new sprint rule stays: it is the
// game's rule, not a strategy.)
constexpr bool F_V71_SMALL_V6 = true;
// F_V71_PROTECT (item 1): the enemy queen is dead (seen to die, or heard) and ours lives: the round-500 tiebreak is ours as
// long as our queen lives. Waves and rangers stop; every teammate becomes a guard of the queen's haven (F_V71_HAVEN) or,
// with no haven, of the queen itself; the queen keeps to its haven and eats nothing outside it.
constexpr bool F_V71_PROTECT = true;
// F_V71_HAVEN (item 2, ESCORT_ARCH 4): every dragon on a medium / large map scores the open ground round it (HAVEN_R
// Chebyshev of a centre, all known, no portal, few corridors, few ways in, far from enemy sightings, on our side, near
// the queen) and reports its best spot on HAVEN_TAG; the queen commits to the best one it hears (or finds), says so on
// HAVEN_TAG, walks there and circles in it (its home for the zero-risk rules). HAVEN_ESC_X100 / 100 of the team (by ID
// hash; HAVEN_ESC_MIN..HAVEN_ESC_MAX, from HAVEN_ESC_POP units) guard its entrances: the tiles just outside the haven that
// lead in (a ring of stations on open ground). From HAVEN_FEED_ROUND the escorts feed the queen. A haven with enemy heads
// in or near it HAVEN_HOT_N times in HAVEN_HOT_WIN rounds is given up for HAVEN_HOT_TTL rounds.
constexpr bool F_V71_HAVEN = true;
constexpr int HAVEN_TAG = 8167;
constexpr int HAVEN_R = 3, HAVEN_EVAL_EVERY = 3, HAVEN_START = 20, HAVEN_MIN_SCORE = 60, HAVEN_SWITCH = 30, HAVEN_KEEP = 30;
constexpr int HAVEN_HOT_R = 5, HAVEN_HOT_N = 4, HAVEN_HOT_WIN = 20, HAVEN_HOT_TTL = 80, HAVEN_TTL = 40;
constexpr int HAVEN_ESC_X100 = 25, HAVEN_ESC_MIN = 2, HAVEN_ESC_MAX = 6, HAVEN_ESC_POP = 10, HAVEN_FEED_ROUND = 440;
constexpr double HAVEN_FOOD_W = 4.0; // a point a pearl-spawning tile in the haven, up to 10
constexpr int HAVEN_ENEMY_R = 12, HAVEN_SIGHT_TTL = 60, HAVEN_MAX_WALK = 16;
// F_V71_STRIDE (item 4): every dragon spends all its free steps (ceil(L / 4)) when each extra step is safe: along its
// route (the queen too, toward its haven), else straight on toward its target. (v7: at most 3 extra steps, no route
// following for the queen, nothing without a route or a pearl.)
constexpr bool F_V71_STRIDE = true;
// Its parts: straight on with no route (STRAIGHT), feeders on their way (FEED), up to STRIDE_MAX steps (LONG; v7: 4).
constexpr bool F_V71_STRIDE_STRAIGHT = true, F_V71_STRIDE_FEED = true, F_V71_STRIDE_LONG = true, F_V71_STRIDE_QUEEN = false;
constexpr int STRIDE_MAX = 8, QUEEN_STRIDE_LEN = 40;
// v7.1: the body history (F_CHOKE_LOOP, the queen's unwind cut) holds HIST_MAX segments (v7: 64). Past 64 the queen's
// unwind fell back to shedding 2 a turn: australia seed 52, boxed in by feed-pipe pieces, 86 long down to 64 in 11 rounds,
// then a cut of 55.
constexpr int HIST_MAX = 160;
// F_V71_WARN: an escort with an enemy head within WARN_R of the queen (or its haven) reports it on the beams that reach the
// queen's body (HAVEN_TAG, flag 2); the queen keeps out of that head's reach as of a ghost (it sees 3 tiles; most queen
// deaths against v7 were rams by 5-8 long dragons sprinting 5-6 steps from the edge of its view). It also counts toward the
// haven's heat.
constexpr bool F_V71_WARN = true;
// F_V71_KILL_CLAIM: a dragon that rams the enemy queen's head this turn (F_REGICIDE) claims the kill on all four beams
// (EQ_TAG, dead bit and claim bit 1). The rules cast sonar after the move and only if the sender lives, and a head-on ram
// kills both, so this is a test of whether any claim gets out.
constexpr bool F_V71_KILL_CLAIM = false; // tested 2026-10-03: 7 claims sent, 0 received in 20 games (seed 53 vs v7)
constexpr int WARN_R = 10;

// ---- v7.2 modules (brief of 2026-10-03, second one; strategyV_7_2.md). Each can be switched off on its own. ----
// F_V72_QID: which of IDs 0 and 1 is our queen. The rules say only "one team's queen is 0, the other's 1": IDs follow the
// map file, whose dragon lines alternate teams, and on the ladder trauma (M919741) team B's came first. v7 took team A's
// queen to be 0, so there the enemy queen was "ours" and our queen (ID 1) played a v6 neutral: portals at rounds 16 and 32,
// a 2-long kamikaze, dead in round 103. Now: a dragon with ID 0 or 1 is our queen; a dragon with ID 0 or 1 in view settles
// it (ours or the enemy's); the queen's heartbeat says which it is (QUEEN_TAG_Q0 / QUEEN_TAG_Q1; plain QUEEN_TAG from a
// dragon that does not know). Without evidence, v7's rule (team A's queen is 0). (A guess from the parity of the ID was
// wrong for half the children born in round 0: they took the enemy queen for ours.)
constexpr bool F_V72_QID = true;
constexpr int QUEEN_TAG_Q0 = 8166, QUEEN_TAG_Q1 = 8165;
// F_V72_BOXOUT (item 4, tower_defense M919740): a dragon that circles (its last BOX_PATH heads within BOX_SPAN of it), has
// eaten nothing for BOX_HUNGRY rounds and has no route to its goal walks the remembered route to the nearest unseen tile,
// as a route (not a scorer hint), until it gets there (at most BOX_TTL rounds). On tower_defense both teams spawn in a
// 7 x 7 box whose one way out is a 1-wide corridor in a map corner: the exploration bonus (+28) lost to the corner (-20)
// and one-exit (-15) penalties, and the first dragon left in round 21-58 (6 seeds, v7 and v7.1; the ladder opponent: 13).
constexpr bool F_V72_BOXOUT = true;
constexpr int BOX_PATH = 16, BOX_SPAN = 4, BOX_HUNGRY = 10, BOX_TTL = 25;
// F_V72_SHED (item 5, slithery_fight M919738): a queen that spawns long (QUEEN_CASCADE_MIN or more) keeps SHED_R0_KEEP in
// round 0 and gives the rest to the cascade (all 2s by the end of round 0, by turn order), then sheds 2 a round down to
// SHED_KEEP while no enemy head is in view: 2 long after round 1 (v7: the queen kept 9, then 7; the ladder opponent shed its
// queen to 3 by round 11 and fed it to 58 from round 200). Keeping 2 in round 0 boxed the queen in among its own cascade's
// 2s: it moves first in round 1 and died; at 4 it splits in round 1 instead of moving, and has room from round 2.
constexpr bool F_V72_SHED = true;
constexpr int SHED_R0_KEEP = 4, SHED_KEEP = 2, SHED_END = 15;
// F_V72_QNOPORTAL (item 3, trauma M919741 turn ~135): the queen's ID crosses no portal on a medium / large map, whatever
// rules it plays (v7 let it under v6's rules until the safe state, after close spawns).
constexpr bool F_V72_QNOPORTAL = true;
// F_V72_REPORTAL (item 2, australia M914728 dragon 14 round 25): the remembered-map routes (memory_bfs) may pass over our
// own tile a second time and leave it backwards, so a dragon that comes out of a portal beside a pocket it can only enter
// from the portal's other end goes back through and in. It was also made a resident on arrival (pearls in view), and a
// resident takes no portal: such pearls now give it the loop exemption a dragon walking out of a dense chamber has.
// F_V72_HIDE (item 1, australia M914728: our queen foraged on the midline, x 28-36 of 64, among the enemy's 54 units, and
// died in round 130 at length 3): on a medium / large map the queen hides deep on our side and eats only there. It scores
// the tiles it has seen and knows a way to (no portal, no corridor, at most HIDE_MAX_WALK moves; hide_bfs): HIDE_DEPTH_W a
// move of distance from the enemy's spawns (the mirror images of ours; over the remembered map, unseen ground open, portals
// both ways), less HIDE_WALK_W a move of its own way there, plus HIDE_ROOM_W of the haven score (open known ground, few
// corridors and ways in), and commits to the best as its haven. Every HIDE_EVAL rounds it moves the haven to anything
// HIDE_STEP better: it sees further as it goes, a climb to the deepest ground it can reach (a goal on unseen ground failed:
// the queen keeps out of ground it cannot prove leads on). It keeps within the haven's tight radius (HAVEN_R + 1 + length / 10),
// pearls included. Escorts guard its gates as before; the team feeds it (ration under QUEEN_RATION_LEN, everybody from the
// feed round).
constexpr bool F_V72_HIDE = true;
constexpr int HIDE_EVAL = 3, HIDE_MAX_WALK = 60, HIDE_CAND = 40;
constexpr double HIDE_STEP = 4.0;
constexpr double HIDE_DEPTH_W = 4.0, HIDE_WALK_W = 0.5, HIDE_ROOM_W = 0.4;
constexpr bool F_V72_REPORTAL = true;
constexpr int REPORTAL_TTL = 20, REPORTAL_POCKET = 24;

// ---- v7.3 modules (brief of 2026-10-03, third: M925522 Around UNSW, M925523 Australia) ----
// F_V73_BLIND (item 1, unsw M925522 dragon 18): the spawn body lies with its head in a blind cell and its tail in a blind
// corridor. The round-0 cascade cut it into five 2s; three were born with nowhere to go but a dead cell and died by round 2
// (6 of 10 segments; 4 is the least: the two blind ends). Now a dragon whose own head can walk does not split in round 0
// when the child (born on its tail) would have no way on that is not a wall, a body or a dead end of the map: it walks,
// and splits from round 1 by the ordinary rules (which look at the child's tile). A head that cannot walk still gives its
// rear L-2 away: that is the only way to save it.
// Dead ends of the map cost the 2-long head left at the tip, so one must hold BLIND_MIN_PEARLS (3) live pearls to be
// entered (v5.7: 2, a wash at best: unsw's 2-cell pocket at (30,41) took a dragon every 7-9 rounds, 15 in 200 rounds).
constexpr bool F_V73_BLIND = true;
constexpr int BLIND_MIN_PEARLS = 3;
// F_V73_CHAMBER (australia M925523: 45 of our 76 deaths in 200 rounds lay in the 12-tile portal chamber at (6..10,23..26),
// where we ate 77 of our 127 pearls): a non-alpha in a small portal chamber does not split inside it (the children could
// not get past the parent to the portal and died boxed in, four heads in twelve tiles). It eats to CHAMBER_EXIT_LEN,
// walks out through the portal and splits outside.
constexpr bool F_V73_CHAMBER = true;
constexpr int CHAMBER_EXIT_LEN = 6;
// F_V73_NAV (item 3, the rework of dispersal and of the way there): legs. On unsw and australia the ladder opponent's dragons
// moved 11-18 tiles net in 25 rounds, ours 7-9: an idle dragon's goal (zone tile, hotspot, crowd exit, box exit, farm) was
// re-chosen most turns and was only a hint to the step scorer, so it turned back within a dozen tiles (12-round net move:
// 6-9 of 12). Now an idle dragon on a map of NAV_AREA tiles or more commits to a leg: a point NAV_R1..NAV_R3 away in one
// of 16 directions, and walks the remembered-map route to it (unseen ground open) as a route, until it is within
// NAV_ARRIVE, the route has not shortened for NAV_STALL turns, or its time is up. Pearls in view still come first, so
// a dragon crossing rich ground stays and eats, splits, and the children leave on legs of their own.
// A leg's score: tiles never seen in the 9x9 block round its end, pearls expected on the seen ones (NAV_W_PEARL), less
// NAV_W_WALK a move of the route; the first leg's direction comes from the ID (siblings fan out), later legs keep roughly
// the heading (NAV_W_HEAD), and a direction a teammate head in view lies in costs NAV_W_MATE.
// It replaces, for these dragons: farm seeking, hotspot scouting, crowd exits, zone goals, the exploration tile, box exits.
constexpr bool F_V73_NAV = true;
constexpr int NAV_AREA = 900, NAV_ARRIVE = 3, NAV_STALL = 10, NAV_SLACK = 12;
constexpr double NAV_W_PEARL = 4.0, NAV_W_WALK = 0.5, NAV_W_HEAD = 14.0, NAV_W_MATE = 18.0, NAV_W_FIRST = 30.0;
// F_V73_QSPLIT (item 4): until the team has QSPLIT_UNITS units (and round QSPLIT_END), the queen sheds 2 off its tail
// whenever it is 4 or longer and no enemy head is within QSPLIT_ENEMY_R: it is a spawner like every other dragon, at
// length 2-3 (the ladder opponent's queen split 11 times by round 100 on unsw; ours twice). Its length comes later, from
// the feeders. Nobody rations it while it sheds.
constexpr bool F_V73_QSPLIT = true;
constexpr int QSPLIT_UNITS = 45, QSPLIT_END = 150, QSPLIT_ENEMY_R = 6;
// F_V73_RING (item 2): the queen's camp and the ground round it.
//  - corner: the hiding search (F_V72_HIDE) measures depth as the walk from the enemy's spawns; over unseen ground it
//    walked through the map's border, so on a map whose border is kelp all round (unsw, australia: no wrap at all) the far
//    corner looked no deeper than the spawn. Border seams known closed (seen, or heard on MAP_TAG) are now walls there.
//  - keep-out: from RING_START, a teammate that is neither a guard nor feeding keeps RING_KEEP_R (Chebyshev) clear of the
//    camp (the haven's centre, else the queen's reported head): no step in, no pearl there, no leg ending there.
//  - ring: the guards (the haven escorts, RING_GUARD_X100 / 100 of the team, RING_GUARD_MIN..RING_GUARD_MAX) stand RING_R
//    out, on the eight compass points by ID (points beyond a closed border are skipped), and ram what comes through.
//    A guard that has heard of the camp once keeps its post for RING_TTL rounds (v7.1: 40, and 1-3 guards were on duty on
//    unsw). Past the feed round it stays while it has seen an enemy head within RING_HOLD_TTL rounds, at most to round
//    ESCORT_FEED_ROUND (v7.1: every guard fed from the feed round, and our queens died in rounds 380-470, rammed by
//    10-23 long dragons sprinting in from the edge of their view).
//  - cramped: a teammate whose body walls the queen's head into fewer than RING_BOX_ROOM free tiles dies (v7: none).
constexpr bool F_V73_RING = true;
constexpr int RING_START = 12, RING_KEEP_R = 5, RING_R = 7, RING_TTL = 250, RING_BOX_ROOM = 3;
// A short queen needs room too: its room test asked for length + 2 tiles, so at length 3 a 5-tile pocket passed and a
// teammate walking by sealed it in (islands seed 62, round 30). Now at least QUEEN_ROOM_MIN.
constexpr int QUEEN_ROOM_MIN = 12;
// F_V73_QFEAR: the queen sees 3 tiles; a 4-long enemy just outside its view rams it in 3 steps the moment it steps that way
// (australia seed 62, round 430: the 47-long queen walked back for a remembered pearl toward a head its guards had
// reported four rounds before, and died on the third tile). Every enemy head it saw or was warned of in the last
// QFEAR_TTL rounds repels it within QFEAR_R moves (QFEAR_W a move, fading with age): no step, target or pearl that way.
constexpr bool F_V73_QFEAR = true;
constexpr int QFEAR_TTL = 14, QFEAR_R = 9;
constexpr double QFEAR_W = 120.0;
constexpr int RING_GUARD_X100 = 25, RING_GUARD_MIN = 3, RING_GUARD_MAX = 14, RING_R2 = 10; // (slots 8-15: a second ring at RING_R2)
// A guard takes and holds its post only with evidence that an enemy can come: a head it saw, or an enemy alpha it heard
// of, within RING_THREAT_TTL rounds. On the sealed halves of stronghold, trauma and autarky nobody ever comes: the
// guards (a quarter of the team, off the pearls and not feeding until round 470) cost 6 of 16 games against v7.2.
constexpr int RING_THREAT_TTL = 100, RING_HOLD_TTL = 20;
// F_V73_OPEN: the ring forms only on a large, wide-open map. A dragon cannot ask what the map is like, so the team takes a
// census by zone (the zone grid of F_SPREAD: 5 x 6 zones of about 137 tiles on a 64 x 64 map):
//  - every dragon counts, per zone, the kelp edges of the tiles it has seen; a zone it has seen OPEN_ZONE_MIN tiles of has a
//    kelp share (kelp edges of 4 a tile);
//  - the map gossip packet (MAP_TAG, bits 34-46, free until now) carries, in turn, one zone's share (zone 5 bits, share in
//    half percents 7 bits) and a summary (how many zones the sender knows, 5 bits, and their mean share, 7 bits);
//  - a dragon's estimate is the mean over the zones it knows, its own or heard, each zone once however often it is
//    reported, and a zone it does not know has the share of its mirror image (the maps are symmetric); a summary it
//    hears that covers more zones than that replaces it. What it sends on is the better of the two,
//    so the widest picture reaches the whole team and all decide alike; a newborn gets it from its parent's beam.
// The map is open when it has OPEN_AREA tiles or more and, from round OPEN_ROUND, the estimate covers OPEN_MIN_ZONES zones
// or more and finds at most OPEN_KELP_X1000 / 10 percent of the edges kelp (OPEN_KELP_HYST more to switch back off).
// (Tried first: the largest single count wins (one dragon's count on unsw ran from 4.8% to 17.4%; kelp stops beams, 43-64%
// of dragon-turns held a verdict); a running average of everything heard (echoes of the first reports round the spawn:
// schooltime, 19.4%, was open on 38% of turns). By zone, where a sample was taken no longer weighs.)
// The queen hears the census like everybody, decides, and its decision rides on its committed haven packet (HAVEN_TAG,
// bits 3-4: 1 no ring, 2 ring) and on every relay of it: a dragon that knows where the camp is knows whether to form
// the ring round it, and the queen's word overrides its own estimate.
// What the team measures on the maps of 2000 tiles or more with 12 zones or more known: big_empty 0%, australia 7.5-12.5%,
// unsw 10-13% (the ring forms); schooltime 16.5-19.5%, islands 18-30%, slithery_fight 15% and more (it does not). The line
// is in the gap, at 14.5% (at 13% the team split on unsw: 18-59% of dragon-turns formed the ring).
// Smaller maps (default, autarky, stronghold, slithery, trauma, maze): no ring either. Without it: the haven escorts of
// v7.1 at the gates. The queen's room and box rules and the corner-aware hiding stay on everywhere.
constexpr bool F_V73_OPEN = true;
constexpr int OPEN_AREA = 2000, OPEN_KELP_X1000 = 145, OPEN_KELP_HYST = 10, OPEN_ROUND = 60;
// (OPEN_MIN_ZONES: with 8 zones known the estimate on unsw ran from 6% to 18% by which zones they were, 8 of its 30 being
// empty, and schooltime's came as low as 14.5%; with 12 they are 10-13% and 16.5% or more.)
constexpr int OPEN_ZONE_MIN = 48, OPEN_MIN_ZONES = 12;
constexpr double RING_KEEP_W = 45.0;

// ---- v7.4 modules (brief of 2026-10-03, fourth: ladder M939587 unsw, M939588 australia, M939590 default, M939592 islands;
// strategyV_7_4.md). Each can be switched off on its own. ----
// F_V74_POCKET (the unsw dead-end loop: a 9-10 long lineage dived into the 1-wide dead ends at (61,11) and (57,10) about 180
// times from round 38 to 499, each dive ending in a rescue split that left a 2-long head to die at the tip; it never grew,
// and 180 of our 496 deaths lay on those two tiles). A dragon of POCKET_BIG_LEN or more enters no dead end of the map (its
// mass is worth more as units than as a pocket farmer); the farm exemption from the dead-end cooldown and the pocket loop
// (F_POCKET_LOOP) apply only below it. pocket_live() counted fast spawners out of view as full: for a dive it now needs
// that many seen, unless the dragon is at most POCKET_SMALL_LEN (no split at the tip: a 2-3 long dives whole).
constexpr bool F_V74_POCKET = true;
// A dive into a 1-wide dead end costs the 2-long head left at the tip: islands seed 72, a 4-long lineage ate 2 a dive at
// (15,12) every 6 rounds for 240 rounds and never grew. A dead end must hold POCKET_MIN_PEARLS (BLIND_MIN_PEARLS 3 + 1).
constexpr int POCKET_BIG_LEN = 7, POCKET_SMALL_LEN = 3, POCKET_BLIND_MAX = 8, POCKET_MIN_PEARLS = 4;
// F_V74_ROOM (unsw: the 27-long alpha lineage did 9 rescue splits in rounds 225-318, never past 27; seed 71 against v7.3: a
// 17-long coiled itself shut in the 5 x 6 room at (1..5,41..46) chasing an exploration tile): a non-queen dragon of
// ROOM_BIG_LEN or more takes the queen's room test: a step must leave it room for its whole body (escape_room, own coils
// freeing on time), or the scorer charges ROOM_W a tile short and the direct step to a target is refused.
constexpr bool F_V74_ROOM = true;
// F_V74_QGUARD (the queen died in all four ladder games, rammed in three): a last filter on the queen's action, whatever
// branch chose it. If it ends on a tile an enemy head in view can reach this turn (pearls on its way paying for steps:
// unsw r225, a 2-long ate the pearl at (48,9) and took the queen on its second step), or one an enemy reported or seen
// lately can (queen_ghost_exposed, now a step longer for a pearl on the way), and a single step or a free 2-step sprint
// does not, the queen takes the best of those instead. And it looks one move ahead: a step after which our own coils and
// the walls leave it fewer than two ways on costs QG_COIL_W a missing way in the scorer (australia r225-233: a 5-long
// queen circled in a 2 x 3 patch until both its moves were in reach of a stalker; default r121 the same in a 4-row strip).
constexpr bool F_V74_QGUARD = true;
constexpr double QG_COIL_W = 500.0, QG_SAFE_W = 400.0;
// F_V74_QEXIT (islands r133-135: our 2-long stepped onto the queen's only way out of a kelp pocket; the queen died): no
// teammate's move ends next to the queen's head when it would leave the queen at most one free tile to step to, if the
// teammate has another move.
constexpr bool F_V74_QEXIT = true;
// F_V74_QDEF (australia r232: our 2-long sat beside the 5-long that took the queen next turn, and did nothing): any
// teammate with the queen in view rams an enemy head that is within its reach of the queen's head (+1 for a pearl), when
// it can reach that head this turn, before anything else it would do.
constexpr bool F_V74_QDEF = true;
// F_V74_QLEN (the ladder queens were 2-3 long for 100+ rounds; at 2-4 a queen has one free step a turn and a 3-long hunter
// two tiles off reaches every tile it can step to: the traced self-play deaths had no unexposed move for 2-3 rounds before
// the ram). The queen sheds (F_V73_QSPLIT, the brood) only from QLEN_SHED long, keeping QLEN_SHED - 2 (two free steps a
// turn), and while it is under QLEN_MIN the ration dragons bring it pearls even in the shedding period.
constexpr bool F_V74_QLEN = false; // v7.5: replaced by F_V75_QSPLIT2
#define QLEN_ON (F_V74_QLEN && (w * h < QLEN_MID_LO || w * h >= QLEN_MID_HI))
constexpr int QLEN_SHED = 7, QLEN_MIN = 5;
constexpr bool QLEN_RATION = true;
// Not on maps of QLEN_MID_LO..QLEN_MID_HI tiles (islands 2240, slithery_fight 1701, schooltime 2400): 88 games against v7.3
// (seeds 73-76): our queen alive 45 against 39, "ours dead, theirs alive" 10 against 18, but islands 2 of 8 against 5
// (16 more games: 5 against 9) and slithery_fight 1 of 8 against 6. (Tuned on 8 games a map: confirmed on fresh seeds.)
constexpr int QLEN_MID_LO = 1500, QLEN_MID_HI = 3000;
// F_V74_ORPHAN (unsw and australia: our queen died at r225 / r233 with theirs alive, which loses the round-500 tiebreak
// whatever else happens; we kept escorts on a dead queen's haven for 100+ rounds, sent one more wave and then fed from
// round ~300, and nobody came within 4 moves of their queen again). Once a dragon knows our queen is dead (seen or heard:
// a queen report of length 0) and has not heard that theirs is, it is a hunter (wave role, every dragon, the feeders
// too): to the enemy queen's last report, else a sweep of the enemy's half that starts at the image of where our queen
// lived (the opponent hides its queen as we do) and moves on every ORPHAN_SWEEP rounds; and nobody feeds.
constexpr bool F_V74_ORPHAN = true;
constexpr int ORPHAN_SWEEP = 30;
// F_V74_QLIGHT (default, close spawns: the queen's ID plays as v6 until the safe state; on the ladder it paired as a
// 2-long kamikaze and wandered to the enemy spawn across the seam; in self-play it died by round 52-58 in 4 of 4): on a
// medium / large map the queen's ID takes no kamikaze, sprint-hunter or pair role in that mode, and its moves go through
// the queen's last filter (F_V74_QGUARD).
constexpr bool F_V74_QLIGHT = true;
// F_V74_QSILENT (unsw r320: our 21-long alpha was walking to feed a queen that had died 95 rounds before; the timeout was
// the map's width + height, 128 rounds): no queen report for QUEEN_SILENT rounds (and the queen not sealed in) is taken
// for its death; a fresh report undoes it.
constexpr bool F_V74_QSILENT = false; // (rejected: unsw seed 81, the queen alive all game, 72 dragons took it for dead, the first at round 70)
constexpr int QUEEN_SILENT = 50;
// F_V74_FEEDUP: a dragon feeds no teammate shorter than itself (alpha or not; the queen excepted: its length is compared
// first at round 500).
constexpr bool F_V74_FEEDUP = true;

// ---- v7.5 modules (brief of 2026-10-03, fifth; strategyV_7_5.md) ----
// F_V75_QSPLIT2 (issue 1, as asked): the queen sheds 2 whenever it is 4 or longer; on a large map (QS2_LARGE_AREA tiles or
// more) until round QS2_LARGE_END, on a medium one until the team has UNIT_TARGET units. Replaces F_V74_QLEN.
constexpr bool F_V75_QSPLIT2 = true;
constexpr int QS2_LARGE_AREA = 3000;
// The unit cap the queen sheds up to, by map size (small maps: the queen's ID plays v6 and splits like everyone), and a
// deadline round after which it stops in any case (QS_DEADLINE 1000: none). Tuned in bench74/qs_* (strategyV_7_5.md).
constexpr int QS_CAP_LARGE = 25, QS_CAP_MEDIUM = 12, QS_DEADLINE = 1000;
// F_V75_SPLIT55 (as asked): below UNIT_TARGET units every dragon but the queen that is 4 or longer splits 2 off (alphas,
// rangers and escorts too) before the feed round; from UNIT_TARGET on the voluntary splits (growth, farm splits, farm
// harvests) stop and only the forced ones remain (escape, rescue, trapped, threat).
constexpr bool F_V75_SPLIT55 = true;
constexpr int UNIT_TARGET = 55;
// F_V75_RECYCLE (issue 14, the ladder opponent held 62 units and turned the rest into pearls its own dragons ate, 94-97% of
// them): at RECYCLE_UNITS units or more, a dragon 2-3 long with a teammate's head next to one of its drop tiles and no
// enemy head within RECYCLE_ENEMY_R dies where it stands (its drop: ceil(L / 2) pearls, head first).
constexpr bool F_V75_RECYCLE = true;
constexpr int RECYCLE_UNITS = 62, RECYCLE_ENEMY_R = 5;
// F_V75_IDLE (issue 10: 44% of our turns "disperse" at ~1 pearl per 100 turns while 40-63 pearls lay on the board; traced,
// the pearls within 6 moves that idle dragons passed over were skipped as claimed by a teammate (most), as having no
// free exit (a pearl at the rim of the 7x7 view: escape_count took every tile outside the view for blocked), and by the
// trophy zone cap on big maps): exits count tiles out of view as open; the zone cap applies only below ZONE_CAP_AREA
// tiles; the queen (which leaves contested pearls) claims no pearl from a teammate.
constexpr bool F_V75_IDLE = true;
constexpr int ZONE_CAP_AREA = 900, CLAIM_MARGIN = 0;
// F_V75_SEAL (trauma: our half is 264 of 1152 tiles, reached only through 2 portals, the enemy's spawn 4 region hops
// away; stronghold: 1 portal, 6 hops; portals: our 208-tile base cannot be reached at all; the queen sheds into a base
// nobody can attack, and on portals it died as a v6 kamikaze in every game). Every SEAL_EVERY rounds a dragon floods the
// remembered map from where it stands over open edges (no portals). The region is our base when it holds our queen's
// last position (or our spawn), and it qualifies when it is
//   - closed: every tile in it seen and every edge known, between SEAL_MIN_TILES and SEAL_MAX_PCT % of the map;
//   - free of the enemy: no enemy head ever seen (or heard of) on its tiles, and not holding the mirror image of our spawn;
// then the verdict is "hard" (1) with at most SEAL_GATES portals on its rim, or "sealed" (2) with more once round
// SEAL_EVIDENCE_ROUND has passed and still nobody came. The verdict goes out on SEAL_TAG (newest wins) and is withdrawn for
// good ("breach", 3, sent on as well) the moment one of us sees an enemy head inside the region.
// While it holds: the queen sheds nothing; voluntary splits stop once we have SEAL_KEEP_UNITS units; from SEAL_FEED_DELAY
// rounds after the verdict the SEAL_SHARE_X100 / 100 of the dragons SEAL_FEED_MIN_LEN or longer carry their pearls to the
// queen (the ration walk, any queen length); and on a small map (queen rules off) the queen's ID becomes the growing alpha,
// with no kamikaze or pair role, and the feeders' first choice.
constexpr bool F_V75_SEAL = true;
constexpr int SEAL_TAG = 8164, SEAL_EVERY = 5, SEAL_MIN_TILES = 40, SEAL_MAX_PCT = 60, SEAL_GATES = 2, SEAL_EVIDENCE_ROUND = 60;
constexpr int SEAL_KEEP_UNITS = 8, SEAL_FEED_DELAY = 10, SEAL_FEED_MIN_LEN = 3, SEAL_SHARE_X100 = 50;
// Evidence without a fully mapped wall (portals: so many inner walls that the base is never all seen before the queen
// dies, round 30-86): on a map of SEAL_PROBE_MAX_AREA tiles or fewer, a region with at most SEAL_EVIDENCE_GAPS unseen sides
// that no enemy head has entered by round SEAL_EVIDENCE_SMALL (small maps) / SEAL_EVIDENCE_ROUND is sealed (2).
constexpr int SEAL_EVIDENCE_GAPS = 0, SEAL_EVIDENCE_SMALL = 30; // (60: false verdicts on 8 of 16 maps in one seed)
// A region walled in but for at most SEAL_PROBE_GAPS sides nobody has seen: SEAL_PROBE_SHARE_X100 / 100 of the idle dragons go
// and look (until round SEAL_PROBE_END), so that the base gets mapped.
constexpr int SEAL_PROBE_GAPS = 120, SEAL_PROBE_SHARE_X100 = 0, // (25: maze 3 of 8 against 5, queen alive 1 against 7; off)
              SEAL_PROBE_END = 200, SEAL_PROBE_MAX_AREA = 2500, SEAL_PROBE_RANGE = 8; // claimed: a teammate CLAIM_MARGIN + 1 moves nearer or more
constexpr int ROOM_BIG_LEN = 10;
// ---- v7.6 modules (brief of 2026-10-04: the ladder losses M962466 australia, M962467 autarky, M962468 default, M962470
// islands; strategyV_7_6.md). Each can be switched off on its own. ----
// F_V76_ESCORT50 (as asked): nobody is an escort while the team has fewer than ESCORT_MIN_UNITS units, in protect mode
// too. (Australia: escorts A4, A8 and A21 ate 0 pearls in their first 100 turns, 8-10 tiles from the queen in a barren
// spawn area: 17 of our 26 starting segments idle through the opening.)
constexpr bool F_V76_ESCORT50 = true;
constexpr int ESCORT_MIN_UNITS = 50;
// F_V76_POCKET3 (autarky: four dead-end pockets of 3 spawners that refill every round carry ~90% of the map's pearls;
// POCKET_MIN_PEARLS = 4 can never be met there, and we ate 5 pearls in them against the opponent's 173): a dead end of at
// most POCKET3_MAX_SIZE tiles pays with 3 pearls (a 2-long diver comes out 3 long and leaves 1 pearl at the tip).
constexpr bool F_V76_POCKET3 = true;
constexpr int POCKET3_MAX_SIZE = 4;
// F_V76_TEND (A1 / A2: 45% of our turns were dispersal at 0.8 pearls per 100 turns, while on 13 of the 18 maps 65-95% of
// the pearl income comes from a few dozen fast spawners; islands: a pearl stood on each every-round tile of our half for
// 147-247 of 275 rounds). A tile is hot once we have watched its countdown reset to HOT_GAP or less (or seen it at 1 or
// less twice running); hot tiles are remembered (HOT_MAX, HOT_TTL rounds). A small dragon with nothing to eat in view
// that is the nearest teammate (of those within TEND_NEAR moves of it) to a hot tile within TEND_RANGE moves
// tends it: it walks to the tile, and while the tile is taken (its own body, the pearl not yet back) it circles the 2x2
// block beside it. Tenders take no leg, portal errand, pair pull, wave or ambush. Tiles in dead ends and behind kelp
// are left to the pocket and chamber rules.
// F_V76_CLAIM (A4: islands, rounds 60-66 of a traced game: five pearls stood on the home tiles for four rounds while four
// of our dragons walked round them, each leaving them to a teammate that left them in turn): a teammate's claim on a
// pearl holds only while it closes on it. We remember, per pearl, who claimed it and from how many moves; a claimant
// that is no nearer the next turn has no claim that turn (the queen's first call on pearls it is near goes the same way).
// The pearl-sharing rule (F_SHARE) is off with it: it gave a pearl beside us to a teammate two tiles further off.
// F_V76_HOME (A5: islands, our queen's home lineage had 3 units at round 100 from 27 pearls, the opponent's 19 from 86;
// a traced tender two tiles from its tile turned away from it because the queen stood beside it). While the queen sheds
// what it eats (qsplit_active: v7.5's shedding period, never under a seal verdict) it is one more forager at home: no
// keep-away zone round it (QUEEN_ZONE_W; the clear tiles at its head stay), no alpha's berth while it is under 6 long, and
// no first call on the pearls near it. (First version: until 50 units. On stronghold, where the queen's own eating at
// the home tiles is its length, it ended 54 long against 81 in 4 games.)
constexpr bool F_V76_HOME = true;
// F_V76_WAVE50 (A1: 14-20% of our ladder turns were wave dragons, dispersing at 0.5-0.7 pearls per 100 turns from round
// 60, with 16-26 units against the opponent's 28-52): waves go out only from a team of WAVE50_MIN_POP units.
// Off: no gain in pearls or units (150 by round 100 with and without it), and against v7.4 on the same 44 games it cost
// enemy-queen kills (17 against 24) and wins (23 against 29).
constexpr bool F_V76_WAVE50 = false;
constexpr int WAVE50_MIN_POP = 50;
// F_V76_RAID (A6: islands, an enemy 2-long worked our home island from round 10 to 62 and ate 11 pearls there beside our
// queen; the opponent ate 155 pearls on the every-round tiles of our half to our 91): a dragon 2-3 long with an enemy head
// it can ram this turn, that head within RAID_R of a hot tile we know on our side of the map, rams it when the trade is
// even or better by length and their heads do not outnumber ours round the spot (the drops fall on our ground).
constexpr bool F_V76_RAID = true;
constexpr int RAID_R = 4;
constexpr bool F_V76_CLAIM = true;
constexpr int CLAIM_MEM = 12, CLAIM_STALL = 2;
constexpr bool F_V76_TEND = true;
constexpr int HOT_GAP = 10, HOT_MAX = 16, HOT_TTL = 120, TEND_RANGE = 12, TEND_MAX_LEN = 6, TEND_FULL_TTL = 6, TEND_ROAM = 6, TEND_NEAR = 3, TEND_WANT = 1;

// ---- v7.7 modules (the ladder battle M998943, 3 wins in 17: analysis_M998943.md; strategyV_7_7.md). Each can be
// switched off on its own. ----
// F_V77_QSHED (as asked: the queen splits early for the unit lead): the queen sheds 2 whenever it is 4 or longer until
// round QSHED_END, whatever the unit count. v7.5's caps (QS_CAP_LARGE 25 / QS_CAP_MEDIUM 12 units) were met by round
// 25-30: our queen shed once in the first 200 rounds on unsw, australia, islands, queen_of_spades and trauma, where the
// opponent's split every time it reached 4 until round ~200. Islands: it held 14 of our 56 length at round 50 with 18
// units against 30.
constexpr bool F_V77_QSHED = true;
constexpr int QSHED_END = 100;
// F_V77_DIVE (weakhold 16 of 16 dives, autarky 11 of 11): F_V75_SPLIT55 split 2 off at length 4 inside the dead end, the
// 2-long parent ate the last pearl and died 3 long on the wall (no rescue split under 4), and its child came back for the
// corpse's 2 pearls and died the same way: a lineage loop that gains nothing (weakhold never had more than 5 units).
// No growth split with our head in a dead end: the dive eats what is there and the tip split (chokefinal / rescue) sends
// L - 2 out, as F_V76_POCKET3 meant ("a 2-long diver comes out 3 long"). Nor by the L - 2 child while it walks out (its
// tail still in the dead end, or its first SPLIT_COOL rounds): the 2-long it shed was born facing the tip behind the
// dying stub and died the round it was born (weakhold, first version: 14 of them in one game).
constexpr bool F_V77_DIVE = true;
// F_V77_QBODY (the queen gave its body away six times in four ladder games: slithery r449 80 to 3, a win at 80 against 57
// that ended 9 against 65; self-play, 24 games: 90 to 5 and 67 to 3). queen_unwind() is the last resort of a queen that
// has coiled shut; the fault is the step that led there. Traced (maze seed 202): a 68-long queen after a feed pearl
// stepped into a region with room for 60 where the other step had room for 70 (the shortage cost QUEEN_ROOM_W a tile,
// less than the pull of the pearl), kept eating there for 28 rounds, and split 85 off. From QBODY_LEN long:
//  - a step that leaves less room than the body needs costs QBODY_HARD more than any pull, so the roomy step wins;
//  - the last filter (queen_guard) swaps a step into a pocket (room under a third of the body, at least QBODY_FATAL_MIN)
//    for the best step that is not one, and never swaps an exposed step for a pocket: a pocket loses the body for
//    certain, a tile in reach only if the enemy takes it (slithery: the filter sent the queen N out of a 51-long's reach
//    into the 2x2 pocket at (30..31,0..1));
//  - the filter also tries free sprints of up to QG_SPRINT_MAX steps (v7.4: single steps and free 2-step sprints; a
//    10-long has 3 free steps, a 77-long 20).
//  - the sprint out of reach (queen_surge) lands in no pocket or blind alley (maze seed 112: a 17-long queen sprinted SSS
//    into a 3-tile pocket of 3 pearls, which is_dead_end_trap() passes because it pays, shed 2 a turn for 9 turns and
//    died 2 long), and a step into a pocket with every other step in reach is swapped for the step in reach that costs
//    the enemy the most;
//  - the room asked for has a margin (a quarter of the body, at least QBODY_MARGIN_MIN: stronghold, a 53-long queen on
//    tiles with room for exactly its body ate once more and was 1 short from then on, 28 rounds before the split), and a
//    step short of room takes no pull from pearls or targets: it is scored on room and on keeping to the edge of the
//    free ground (QBODY_HUG a blocked side: filling a region along its walls leaves the coils time to free).
constexpr bool F_V77_QBODY = true;
constexpr int QBODY_LEN = 5, QBODY_FATAL_MIN = 6, QG_SPRINT_MAX = 4, QBODY_MARGIN_MIN = 4;
constexpr double QBODY_HARD = 4000.0, QBODY_HUG = 40.0;
// F_V77_QTHREAT (australia r207-209, queen_of_spades r252-254: the queen walked toward a 3-long in view until both its
// steps were inside that dragon's sprint reach): the reach test (build_exposed) is one turn deep. A second map,
// queen_approach(), holds the tiles an enemy head in view reaches after one more move of free steps: the scorer charges
// QT_ZONE_W for a step onto one (more than any pearl or target pulls, less than a tile in reach now), the direct step to a
// target is refused there, and the last filter swaps such a step for one outside the zone when there is one.
constexpr bool F_V77_QTHREAT = true;
constexpr double QT_ZONE_W = 700.0, QT_GUARD_W = 400.0;
// F_V77_APEX (queen_of_spades r472: with both queens dead our 37-long apex, against a team whose longest was 5, sprinted
// to 2 tiles from a 3-long and was rammed; 23 of our dragons of 8 or more went that way in the 17 games): an alpha of
// APEX_GUARD_LEN or more takes the queen's last filter (no step into an enemy's reach or a pocket when another exists).
constexpr bool F_V77_APEX = true;
constexpr int APEX_GUARD_LEN = 10;
// F_V77_TIE (australia: after our queen died at r209 the whole team hunted, our length fell from 190 to 44, we killed
// their queen at r494, and with both queens dead the longest dragon decided: 7 against 67; islands: 40-50% of our turns
// hunted a queen that had died at r76, unseen). Orphan mode needs both things: their queen dead and the longest dragon.
// ORPHAN_HUNT_X100 / 100 of the team (by ID hash) are the hunters; the rest forage, split and feed the apex from the
// feed round as in a game with no queen.
constexpr bool F_V77_TIE = true;
constexpr int ORPHAN_HUNT_X100 = 50;
// F_V77_QGROW (the opponent's queen grows from round ~200 with 30-60 units still eating: unsw 21 against our 14 at round
// 275, slithery 38 against 15 at round 350; ours waits for the feed round, and at the unit cap the income is burned: unsw,
// ~1000 pearls eaten in rounds 75-325 for +19 team length): from round QGROW_START, with QGROW_UNITS units or more, the
// ration (F_QUEEN_RATION) has no length limit: QGROW_SHARE_X100 / 100 of the dragons 3 or more long within RATION_RANGE of
// the queen bring it their pearls.
constexpr bool F_V77_QGROW = true;
constexpr int QGROW_START = 200, QGROW_UNITS = 24, QGROW_SHARE_X100 = 34, QGROW_RANGE = 16;
// F_V77_KEEP (the feed ends our harvest: units at round 400 13 against 31 on slithery, 9 against 36 on maze; pearls in
// rounds 400-499 97 against 427 and 111 against 410): KEEP_SHARE_X100 / 100 of the dragons of at most KEEP_MAX_LEN (by ID
// hash, not the ration's share) go on foraging and splitting through the feed phase until round KEEP_END; their children
// that are not keepers carry the harvest to the queen. Not in a sealed base (F_V75_SEAL): there everything goes to the queen.
constexpr bool F_V77_KEEP = true;
constexpr int KEEP_SHARE_X100 = 25, KEEP_MAX_LEN = 4, KEEP_END = 440;
// F_V77_RECYCLEQ (F_V75_RECYCLE turned 2-3 long dragons into pearls beside any teammate at 62 units: unsw 70 such deaths,
// slithery 158, each losing half its length for nothing): on a map with the queen rules, only beside the queen's head.
constexpr bool F_V77_RECYCLEQ = true;
// F_V77_REACH (analysis_M998943_v2.md A1 / A2: australia r209, islands r113): build_exposed() took every enemy whose body
// touched the edge of our view for 12 long, so its reach covered the whole view, no step was "safe" and the last filter
// kept the step it was given. Now a body that leaves the view is as long as we remember that ID (elen_mem), else its
// visible length + 2 or the longest enemy we have seen whole in the last REACH_MEM rounds, whichever is more (12 at most;
// REACH_UNKNOWN before any was seen). And when every candidate is in reach the filter takes the one that costs the enemy
// the most steps (then the most room), free sprints included, instead of the original step.
constexpr bool F_V77_REACH = true;
constexpr int REACH_MEM = 150, REACH_UNKNOWN = 5;
// F_V77_QFRESH (analysis_M998943_v2.md B1: unsw, 54 of 58 dragons walked for 125 rounds to feed a queen that had died
// unseen at r315: feed_target() takes a report up to queen_timeout() = W + H rounds old): the queen is the feed target only
// on a report at most QFEED_FRESH rounds old; with an older one the best alpha is (the apex, as in a game with no queen).
constexpr bool F_V77_QFRESH = true;
constexpr int QFEED_FRESH = 60;
// F_V77_QPORTAL (stronghold seed 112: our 100-long queen died at r436 when a 2-long teammate came out of a portal onto
// its head; the ladder battle had three such head-ons): nobody steps through a portal that lands within 2 tiles of the
// queen's reported head (a report at most 3 rounds old). It takes another step, or a dragon of 3 or less dies where it is.
constexpr bool F_V77_QPORTAL = true;

// ---- v7.8 modules (the 2026-10-04 brief after battle M1008740; strategyV_7_8.md). Each can be switched off on its own. ----
// F_V78_FEEDHOME (item 1): from the feed round the queen stays in its haven: it eats only inside the haven's tight radius
// (HAVEN_R + 1 + length / 10, as in protect mode), takes no remembered or upcoming pearl outside it, and its hiding place
// stops moving unless enemies make it hot. The feeders come to it (its heartbeat goes out every turn and is relayed).
// (v7.7 maze seed 121: from round 355 the queen walked 178 tiles in 120 rounds round the west third of the map after
// pearls, 43 to 103 long, and was rammed foraging at round 474.)
constexpr bool F_V78_FEEDHOME = true;
constexpr int FH_OUT = 10; // rounds out of a haven too small for the body before the queen may pick another
constexpr double HIDE_WALK_FEED_W = 4.0; // (HIDE_WALK_W 0.5) a haven picked in the feed phase is one near the queen
// F_V78_CLAIM (item 2): a dragon with the enemy queen's head in view and at most its own reach + CLAIM_SLACK moves away
// chases it (the ram itself is F_REGICIDE's) and claims the kill on its beams every turn it does, the claim round riding on
// every enemy-queen report from then on. A dragon that hears a claim takes the enemy queen for dead until a sighting
// CLAIM_GRACE or more rounds younger than the newest claim says otherwise. With the enemy queen dead nobody hunts (waves,
// rangers, orphan hunters), protect mode no longer makes every dragon an escort (the escort share of F_V78_ESC41 guards
// the queen), and the rest forage and consolidate into our queen, or the longest dragon, in the feed phase.
constexpr bool F_V78_CLAIM = true;
constexpr int CLAIM_SLACK = 2, CLAIM_GRACE = 4;
// A chase claims for at most CLAIM_TURNS turns in a row, then not again for CLAIM_COOL rounds (diag78f, default seed 132: a
// 30-turn chase that never rammed kept the team wrong for 373 rounds); a claim nobody saw come true (no death witnessed)
// counts for CLAIM_TTL rounds after the newest one (a claimant that dies otherwise cannot take its claim back).
constexpr int CLAIM_TURNS = 3, CLAIM_COOL = 15, CLAIM_TTL = 50;
// F_V78_ESC41 (item 3): escorts from ESC78_UNITS units (v7.6: 50), and once the team has had that many (latched by every
// dragon that sees it, and in the queen's heartbeat for those born later: roster slot ESC78_LATCH_MARK) the escort share
// stays on duty whatever the unit count, through the feed phase to ESCORT_FEED_ROUND.
constexpr bool F_V78_ESC41 = true;
constexpr int ESC78_UNITS = 41, ESC78_LATCH_MARK = 61;
// F_V78_QGUARD (item 4, analysis_M1008740.md 4.3a / 4.3b, slithery r296: EEN into the 2x2 pockets, room 101 with the path
// free and 8 with it as body, and 8 passed the third-of-the-body veto): queen_guard's test of the move it is handed counts
// the tiles its own path puts the body on as walls, and a landing is a pocket when it has room for less than the body and
// its margin (len + 2 + max(QBODY_MARGIN_MIN, len / 4)) while another candidate has more. Swapping a pocket for a tile in
// an enemy's reach still needs the old hard pocket (room under a third of the body).
constexpr bool F_V78_QGUARD = true;
// F_V78_HEIR (item 5): our queen is dead (seen, or no report for queen_timeout() rounds) on a medium / large map: the
// longest dragon in view of HEIR_MIN_LEN or more becomes an alpha (the heir) at once, not at the feed round; alphas make no
// growth split; and HEIR_SHARE_X100 / 100 of the dragons 3 or more long within HEIR_RANGE of the best alpha (by ID hash,
// not the orphan hunters) bring it their pearls from then on, before the feed round.
constexpr bool F_V78_HEIR = true;
constexpr int HEIR_MIN_LEN = 4, HEIR_SHARE_X100 = 34, HEIR_RANGE = 20, HEIR_FEED_START = 200;
// (a queen known to be sealed in a cell is not dead: schooltime, its silence made heirs from round ~60 and 40% of the team
// fed them instead of multiplying: 0 of 4 against v7.7, 2 of 4 without the heir; the feeding starts at HEIR_FEED_START)
// F_V78_FEEDWAVE (item 7): the feed phase goes in FEEDWAVES waves FEEDWAVE_GAP rounds apart: a dragon's wave is the hash of
// its ID (FEEDWAVE_MODE 1) or its distance to the queen (2: the nearest first, 3: the farthest first); until its wave comes it forages as a keeper
// does, and it leaves in time to arrive in any case (500 - FEEDWAVE_MARGIN - its distance - half its length).
constexpr bool F_V78_FEEDWAVE = true;
constexpr int FEEDWAVES = 3, FEEDWAVE_GAP = 20, FEEDWAVE_MODE = 1, FEEDWAVE_MARGIN = 25, FEEDWAVE_NEAR = 12;
// From the feed round a dragon that is not feeding (its wave not come, a keeper) keeps FW_KEEP_R (Chebyshev) clear of the
// queen's head: no pearl or goal there, no step in (diag_final maze seed 131: a 2-long forager waiting for its wave walked
// along the 57-long queen's head and ate the pearl it was going for; with two more small dragons beside it the queen was
// walled in at round 390 and cut 46 off at 394).
constexpr int FW_KEEP_R = 4;
// F_V78_QSHED (item 6, as asked; replaces F_V77_QSHED): the queen never sheds on a large map (QS2_LARGE_AREA tiles or more:
// australia, unsw, big_empty; the brood off there too) and on a medium one sheds 2 at length 4 or more while the team has
// at most QS78_MEDIUM_UNITS units.
constexpr bool F_V78_QSHED = true;
constexpr int QS78_MEDIUM_UNITS = 12;

// ---- v7.9 modules (the 2026-10-04 v7.9 brief; strategyV_7_9.md). Each can be switched off on its own. ----
// F_V79_MEM (items 2 and 4): every dragon keeps a memory of the teammates and enemy heads near it: those in its view each
// turn, and those heard on FRIEND_TAG beacons, for MEM_TTL rounds. A small dragon (BEACON_MAX_LEN or shorter) sends a beacon
// on one beam a turn on small maps (every other turn, on a beam nothing else wants, elsewhere): its head, ID and length, and
// the nearest enemy head in its view.
constexpr bool F_V79_MEM = true;
constexpr int FRIEND_TAG = 8163, MEM_FRIENDS = 24, MEM_ENEMIES = 16, MEM_TTL = 8, BEACON_MAX_LEN = 6;
// F_V79_BANK (item 1): on a small map (QUEEN_SMALL_AREA tiles or fewer) our home, the part of our half more than
// bank_band() from the midline, is banked when the enemy can reach it only through the middle, past us: the wrap seam
// behind our half is kelp (F_CENTER_PUSH's check) and no portal leads out of our home (a portal end seen there whose partner
// is unknown, or off our home and the centre band, vetoes it for good). The verdict and the veto go round the team on
// BANK_TAG from round 0. Banked, until BANK_END: home pearls are left where they are (unless BANK_ADJ moves away; with 1
// the next pearl of a pocket is adjacent again and chains the dragon into it), a dragon on our side with no pearl to eat
// off the home, or a goal in it, rushes to the centre band (bank_rush_target(), over the remembered map), the alpha too
// (v6: only to round V6_ALPHA_PUSH_END). After BANK_END the bank is collected (remembered home pearls come first for the
// idle). A vetoed map gets no centre push at all (v6 pushed on dilemma and portals, whose portals lead round the middle).
constexpr bool F_V79_BANK = true;
constexpr int BANK_TAG = 8162, BANK_END = 100, BANK_ADJ = 0, BANK_MID = 1, BANK_COLLECT_TTL = 120, BANK_COMMIT = 12;
// F_V79_GROUP (item 2): on a small map our small dragons (PAIR_MAX_LEN or shorter) keep in groups: of GR_SIZE_SMALL on a map
// of GR_AREA_SMALL tiles or fewer, else GR_SIZE (12 dragons: 3 groups of 4 on dilemma, 2-3 of 5 on stripes; screened on
// seeds 141-148 against groups of 3 / 4 within 4, see strategyV_7_9.md: only these tight groups with GR_FIGHT moved the
// drops we eat). A group is
// the nearest teammates within GR_R known from the memory (out of view too); short of a full group a dragon with nothing
// better to do walks to the nearest teammate it knows of within GR_JOIN_R; a crowd of more than the group size + GR_SLACK
// sends its highest IDs away for GR_LEAVE_TTL rounds (they found a group of their own). Members keep within GR_R of the
// group's centre (v6's cohesion, with the memory's members). From GR_START with GR_MIN_UNITS units, to the feed round.
constexpr bool F_V79_GROUP = true;
constexpr int GR_AREA_SMALL = 450, GR_SIZE_SMALL = 5, GR_SIZE = 4, GR_R = 3, GR_TTL = 3, GR_JOIN_R = 12, GR_SLACK = 1,
              GR_LEAVE_TTL = 12, GR_LEAVE_DIST = 7, GR_START = 3, GR_MIN_UNITS = 4, GR_JOIN_FOOD = 4;
// Cohesion in the move scorer: GR_W a tile beyond GR_KEEP_R - 1 of the group's centre (v6: V6_GROUP_R, V6_GROUP_W). With
// GR_FIGHT, a member with nothing better to do walks toward an enemy head the memory saw this round or last within GR_FIGHT_R
// of it and within 3 of a teammate (a fight one of us is in: its drops are near).
constexpr int GR_KEEP_R = 3, GR_FIGHT_R = 7;
constexpr double GR_W = 20.0;
constexpr bool GR_FIGHT = true;
// GR_LEAD: the group's lowest ID leads (it forages as it likes); the others follow it: no pearl more than GR_LEASH from the
// leader (unless beside us), back to it when further than GR_LEASH, and the move scorer's cohesion is toward the leader
// (a centroid moves with its members and pulls weakly: build A's groups left the teammate proximity unchanged).
constexpr bool GR_LEAD = false;
constexpr int GR_LEASH = 3;
constexpr double GR_LEAD_W = 25.0;
// F_V79_QMEM (item 3): the queen remembers every tile it has seen (edges, kelp, portals, and whether a dragon stood on it;
// the cell memory, plus the enemy heads seen on each tile). Cornered (every free step lands in an enemy's reach) and no
// sprint inside its view gets it out (queen_surge), it sprints out of its view over remembered ground: known open edges only
// (no portal, no unknown edge), tiles seen free within QM_TTL rounds with no enemy head on them for QM_ETTL and none within
// QM_EDGE_R of a body we see running out of our view (QM_EDGE_R 3 and QM_TTL 20 blocked all but 1 escape in 88 large games;
// these settings made 10, see strategyV_7_9.md), onto a landing
// at least QM_OUT (Chebyshev) away that no visible enemy reaches, with room for its body; paying at most QM_MAX_COST segments
// and keeping QM_MIN_LEN.
constexpr bool F_V79_QMEM = true;
constexpr int QM_STEPS = 10, QM_TTL = 40, QM_ETTL = 6, QM_OUT = 4, QM_MAX_COST = 8, QM_MIN_LEN = 2, QM_EVAL = 8, QM_EDGE_R = 1;

// ---- v7.10 modules (the 2026-10-05 brief, strategyV_7_10.md) ----
// F_V710_QBLIND (item 1, M1058786 Around UNSW round 410: the 39-long queen's 8-step escape over remembered ground ran along a
// kelp wall into the tail of its own escort, five tiles off and two rows outside its view; it had seen that escort two
// rounds before, one tile from where it hit it). The escape's tiles outside the view were "free" when the memory had seen
// them free within QM_TTL rounds, whoever had stood beside them since, and a tile another dragon stood on at our last
// sighting counted as free too (only our own body there barred it). Now a tile out of view is known free only if
//  - no other dragon's segment stood on it when we last saw it (Cell::other_seen), and
//  - no teammate the memory holds (seen or heard within QB_MEM_TTL rounds, out of view now) can have walked onto it: it is
//    more than QB_PAD + a tile a round + its body (QB_BODY at most) from where its head was, and no enemy head the memory
//    holds within QB_PAD + QB_ESPEED tiles a round;
// the escape crosses at most QB_MAX_BLIND such tiles, each seen within QB_TTL rounds, and every one of them costs QB_W in
// the landing's score (the fewest blind steps that get out of reach).
// Measured (strategyV_7_10.md; every traced queen turn's escape walked over the replay's true board, 88 games on fresh
// seeds): v7.9's rule meets something on the way in 13.2% of the escapes it offers (21.3% with an enemy in view), this one
// in 1.2% (1.5%), and offers one a third as often; 11 real escapes in 264 games, none dead in its round.
constexpr bool F_V710_QBLIND = true;
constexpr int QB_MEM_TTL = 8, QB_PAD = 1, QB_ESPEED = 2, QB_MAX_BLIND = 3, QB_TTL = 12, QB_BODY = 4, QB_OWN_PAD = 2;
constexpr double QB_W = 1.5, QB_AGE_W = 0.4;
// (QB_TTL: over 8,323 traced queen turns, an escape under these rules whose stalest tile out of view was seen 0-3 rounds
// before met something on the true board in 0.7% of cases, 4-12 rounds before in 3.2%, 13 or more in 5.6%; v7.9 went by
// sightings up to 40 rounds old. QB_AGE_W a round of that age comes off a landing's score.)
// (F_V710_QBLIND, the queen's own coils out of view: v7.9 let the escape onto a tile its own segment leaves on that very
// step, and a pearl eaten on the way keeps the tail a step longer: 52 of 7,325 traced escapes ended on its own body. Now
// a coil must be gone QB_OWN_PAD steps before the head gets there.)
// F_V710_QBEACON: the teammates round the queen tell it where they are. A dragon within QBC_R of the queen's last report
// sends its beacon (FRIEND_TAG: head, ID, length) on the beam that points at the queen, every turn, whatever its length or
// role and in the feed phase too; the queen's memory then holds the dragons just outside its view (v7.9's beacons go out on
// a free beam only, and on a large map the queen's relay leaves none: the memory held the teammates it had seen itself).
constexpr bool F_V710_QBEACON = true;
constexpr int QBC_R = 9;
// F_V710_ZONES (item 2): pearl-rich and pearl-barren zones, known to the whole team, and who works which.
// The map's pearls are not spread evenly: on Around UNSW, by the nominal rate, six of the 30 zones spawn 26 of the map's 30
// pearls a round and 16 spawn next to nothing; in the ladder game M1058786 a third of our dragon-rounds were spent in those
// 16. (By what a zone can be made to yield, below, it is 6 rich, 3 ordinary and 21 barren.)
// Measured (strategyV_7_10.md, fresh seeds, the eight large maps with rich and barren zones): every truly rich zone called
// (148 of 148), 95% of the barren ones; our dragon-rounds in rich zones 40.5% against v7.9's 37.2%, in barren ones 45.3%
// against 48.9%, walking with no purpose in a barren zone 8.4% of turns against 14.5%; every departure for an enemy-side
// zone in a party of 3+. It does not pay: pearls eaten in rich zones 695 a game against 703, wins level (24 and 23 of 44
// against v7.9 and v7.8, control 21), units at round 300 down 6%, the queen's report older (39% of dragon-turns hold one
// over 30 rounds old against 32%).
//  - The estimate. Zones are those of F_SPREAD (about 9x9, at most 32). A zone's rate is what it can be made to yield, summed
//    over its spawners we have seen, or whose mirror image we have seen (the map is symmetric, countdowns and all). A tile
//    whose countdown stood at 1 or less on two sightings running (or on its only one) spawns every round; one whose countdown we watched reset
//    twice spawns 2 / (1 + its longest gap) a round; the others are pooled on the highest countdown each has shown us:
//    n of them with highest countdowns c1..cn give n / (ZN_POOL_K * mean c) (a countdown seen once is a third of the
//    longest gap on average, the mean gap half of it), and no more than ZN_POOL_CAP a tile (a first build pooled
//    the countdowns of the moment and kept the highest estimate: every tile runs down to 1 before it resets, so two
//    slow tiles seen late in their countdown made a zone rich, nine barren zones a game on Schooltime).
//    No tile counts for more than ZN_OPEN_CAP a round (a dragon looping over an every-round tile is back on it every
//    fourth round), and a tile in a dead end (the known map pruned leaf by leaf) for no more than ZN_DEAD_CAP: in the 17
//    games of battle M1008740 the every-round tiles in 1-wide pockets (22 of Around UNSW's 24) gave both teams together
//    0.02-0.09 pearls a round each, the price of a dive being the 2-long head that stays at the tip. By the nominal rate
//    those pockets were the richest zones on the map, and a first build sent the team to them.
//    Rich: ZN_RICH_LV eighths of a pearl a round or more; barren: ZN_BARREN_LV or fewer with ZN_COVER_PCT of the zone known.
//  - The broadcast (ZINFO_TAG, one beam a round in turn): rich zones two to a packet (the zone's hottest tile, its level,
//    the round an eyewitness last vouched for it), the barren zones as one mask, claims two to a packet (zone, ID, state,
//    age). A receiver adds the mirror image of every rich zone it hears of. A report not refreshed for ZN_HEARD_TTL rounds
//    lapses (an eyewitness refreshes it every time it sends).
//  - Who goes where. A dragon with nothing to eat in view (the queen, escorts, rangers, waves and campers apart) that stands in a
//    rich zone stays: it walks to the spawner of the zone that pays soonest. Elsewhere it sets off for the nearest rich
//    zone with room (a leg to its hottest tile, in place of F_V73_NAV's leg to nowhere in particular). A zone has room by
//    its rate (zn_cap(), ZN_CAP_MAX at most): the claims we hold for it (going or there) count against that, and
//    on the spot the teammates in view do; over it, the highest IDs leave for another rich zone with room, when there is
//    one, and shun the zone for ZN_BAN rounds.
//    Legs (the dragons no rich zone has room for, and the scouts: see ZN_SCOUT_MOD) do not end in a zone known barren, and
//    one that does is dropped.
//  - The enemy's side (the zone's hottest tile is nearer their spawn, the mirror image of ours, than ours by more than
//    ZN_SIDE_MARGIN): nobody goes alone. A dragon that would go pledges instead (a claim in state 1) and carries on as
//    before; it sets off once ZN_PARTY of us are in it together (claims of any state it holds for that zone, and teammates
//    within ZN_PARTY_R in view), or two of us hold the zone already. Our own side's zones are filled first.
// It acts on maps of ZN_AREA tiles or more, and only once some zone is known rich (default, big_empty: never).
constexpr bool F_V710_ZONES = true;
constexpr int ZINFO_TAG = 8161;
constexpr int ZN_AREA = 701, ZN_EVERY = 3, ZN_RICH_LV = 4, ZN_BARREN_LV = 1, ZN_COVER_PCT = 60, ZN_HEARD_TTL = 120;
constexpr double ZN_OPEN_CAP = 0.25, ZN_DEAD_CAP = 0.03, ZN_POOL_CAP = 0.065, ZN_POOL_K = 1.5;
// A dragon per quarter of a pearl a round in a zone of up to a pearl a round, and one per eighth beyond that: a small rich
// zone is not crowded, a large one takes what the team can send (at 35-45 units and 3-4 pearls a round on our side of a
// large map a dragon's share is about a tenth of a pearl a round; with a quarter everywhere, Schooltime's one large zone
// of 26 tiles took 8 of us and the rest walked its corridors: 22% of our dragon-rounds in rich zones against v7.9's 29%).
constexpr int ZN_PER_LV = 2, ZN_BIG_LV = 8;
constexpr int ZN_CAP_MAX = 12, ZN_CLAIMS = 8, ZN_CLAIM_TTL = 12, ZN_BAN = 40, ZN_STALL = 12, ZN_KEEP = 6;
constexpr int ZN_PARTY = 3, ZN_PARTY_R = 5, ZN_SIDE_MARGIN = 4, ZN_FAR_PEN = 15, ZN_GAP1_FLOOR = 20, ZN_PATROL_WAIT = 20;
constexpr double ZN_LEG_PEN = 40.0; // (a leg's score runs to about 80: unseen tiles in the 9x9 block round its end)
// Scouts: while ZN_SCOUT_PCT of the zones are still unexplored by the team (F_SPREAD's explored mask, which goes round on
// MAP_TAG) and before round ZN_SCOUT_END, every ZN_SCOUT_MOD-th dragon stays out of the zone rules and walks legs, which go
// for unseen ground. Without them the team settled in the first rich zones it found: on Schooltime seed 171 nobody saw
// the map's largest zone (26 tiles, 2.5 pearls a round) before round 320 (v7.9, on legs alone, spent 13% of its
// dragon-turns in that zone).
constexpr int ZN_SCOUT_MOD = 3, ZN_SCOUT_PCT = 15, ZN_SCOUT_END = 220;
constexpr bool ZN_FAR = true;        // enemy-side rich zones are goals at all (off: our own side only)
// F_V79_KMEM (item 4): a small dragon (KM_MAX_LEN or shorter, not an alpha) rams an enemy head it can reach this turn, at
// least as long as itself, when the memory knows KM_FRIENDS or more of our dragons within KM_FR of the collision (at least
// one of them out of view: what the memory adds to the strike rules), no other enemy head known within KM_ER of it (seen or
// heard in the last KM_ETTL rounds) and our nearest known teammate nearer to it than any other enemy head: our dragons pick
// up both drops.
constexpr bool F_V79_KMEM = true;
constexpr int KM_MAX_LEN = 4, KM_FRIENDS = 3, KM_FR = 6, KM_TTL = 4, KM_ER = 3, KM_ETTL = 6, KM_MIN_UNITS = 4;

// ---- v7.11 modules (the 2026-10-05 v7.11 brief, strategyV_7_11.md). Each can be switched off on its own. ----
// F_V711_MEMLEN (item 3): every dragon but the queen sends the FRIEND_TAG beacon (v7.9: only those of BEACON_MAX_LEN or
// shorter), so every dragon's memory holds the teammates near it and their lengths; the beacon carries the nearest enemy
// head's length (3 bits, 7: 7 or more; v7.9 sent one bit, 4+ or not) and its round as round mod 32 (a report lives MEM_TTL
// rounds). Bit 48 carries the small-map push (F_V711_SMALL).
constexpr bool F_V711_MEMLEN = true;
// F_V711_INTRUDE (item 3): an enemy head on our side of the map (side_depth(): nearer our spawns than their mirror images by
// IN_MARGIN or more) is rammed early, before it settles in and dismantles us. A dragon of IN_MAX_LEN or shorter (not the
// queen, an alpha, an escort or a ranger) that can reach it this turn (a step, or a sprint that pearls or its length pay
// for) rams it when it is at least our length - 1, with no teammate in view needed (the teammates near our own ground eat
// the drop: the drop call goes out the turn before); not when more than IN_MAX_OTHERS other enemy heads are within
// IN_OTHERS_R of the collision, nor with one there and no teammate known within IN_FR. It comes before the evasion sprint
// (an intruder in our face is struck, not fled). A small dragon with no pearl beside it walks to an intruder the memory saw
// within IN_HUNT_R in the last IN_HUNT_TTL rounds.
constexpr bool F_V711_INTRUDE = true;
constexpr bool IN_REQ_MEM = false; // (true: a teammate the memory knows within IN_FR of the collision, always)
constexpr int IN_MAX_LEN = 4, IN_MARGIN = 2, IN_OTHERS_R = 3, IN_MAX_OTHERS = 1, IN_FR = 8, IN_HUNT_R = 10, IN_HUNT_TTL = 3,
              IN_MIN_UNITS = 3, IN_FR_TTL = 6;
// F_V711_SMALL (item 2): small maps (QUEEN_SMALL_AREA tiles or fewer), every one of them.
//  - The queen stays behind (SQ_STAY): the queen's ID eats on our side only (side_depth() SQ_SIDE or more), walks back to its
//    spawn by the remembered map when it is in the middle or beyond (an alpha's move otherwise goes to the scorer), and with
//    nothing to eat patrols our side's spawners within SQ_HOME_R of it; it splits as v6 does to SQ_KEEP_ROUND (half our
//    opening units come from it) and keeps SQ_SPLIT_LEN - 2 after that. (A queen held within 7 of its spawn starved: Trophy's
//    spawn handles never spawn, Tower Defense's one-door box a pearl in 250 rounds a tile; 23 of 112 games against 60.)
//  - The push (PU_ON): once a dragon's memory holds PU_OURS of us in the centre band and at most a third as many enemy heads
//    there or on our side (from round PU_MIN_ROUND, with PU_MIN_UNITS units), or in the census's aggression mode (1.5 times
//    as many units as the enemy can have), the team pushes (the beacon's bit 48 spreads it): a dragon with no pearl within 3
//    goes for the nearest enemy head the memory knows within PU_HUNT_R moves, else for the enemy's spawns (the mirror images
//    of ours), in groups: a dragon more than PU_LEAD tiles ahead of its group's centre walks back to it. On the enemy's side a
//    small dragon rams an enemy head at least its length when the memory knows PU_FRIENDS of us within PU_FR of the
//    collision and no more enemy heads there than teammates (PU_STRIKE).
//  - Built and measured harmful, off: SM_RUSH (every other dragon rushes the centre band before the push: v7.10 is there by
//    round 15 already, and the rush took dragons off the pearls on the way; first head in the band at round 18.9 against
//    13.6) and SM_FILTER (the others leave our deep home's pearls to the queen in the opening).
constexpr bool F_V711_SMALL = true;
constexpr int SQ_SPLIT_LEN = 6, SQ_KEEP_ROUND = 60, SQ_SIDE = 2, SQ_HOME_R = 8, PU_MIN_ROUND = 50, PU_OURS = 5, PU_MIN_UNITS = 10, PU_KEEP_UNITS = 6,
              PU_HUNT_R = 9, PU_LEAD = 2, PU_FRIENDS = 2, PU_FR = 4, PU_MAX_LEN = 4, PU_TTL = 4;
constexpr bool SQ_STAY = true, SM_RUSH = false, PU_ON = true, PU_STRIKE = true; // (SM_RUSH: measured harmful, see strategyV_7_11.md)
constexpr int SM_HOME_END = 80; // (SM_FILTER: the others leave our deep home's pearls to the queen until this round, or the push)
constexpr bool SM_FILTER = false; // (measured harmful: the opening slowed, see strategyV_7_11.md)
// F_V711_ZONES (item 1): v7.10's zones reworked (strategyV_7_11.md: why v7.10's did not pay). A rich zone gives one of our
// heads 0.129 pearls a round, 2-4 heads 0.096 each, 5 0.080, 6 or more 0.061, and 6+ was the commonest state; the first head
// in an empty rich zone earns 0.129, in an empty ordinary zone 0.071. v7.10's rules governed only dragons with nothing in view
// (5% of turns).
//  - The crowd rule (Z2_CROWD): every small dragon in a rich zone counts our dragons there (view, memory, claims); over
//    Z2_CROWD_CAP the highest IDs leave together (on the same departure round, every Z2_DEPART_EVERY-th) for the goal picked
//    from the zone's anchor (every leaver picks the same): a rich zone with room, else an empty ordinary zone of Z2_ORD_LV or
//    more, else a hunt (the nearest enemy head the memory knows on our side or in the middle within Z2_HUNT_R), else for a
//    party of ZN_PARTY or more an enemy-side rich zone within Z2_FAR_K. On the way only a pearl beside us stops them.
//  - Beats (Z2_BEATS): a zone worker walks to the spawner that pays soonest among those no teammate (in view, or in the memory
//    within Z2_BEAT_TTL rounds) is nearer to.
//  - Room counts the memory (Z2_MEMROOM); no walk to a rich zone more than Z2_MAX_K moves away (Z2_TRANSIT); v7.10's own
//    over-room leavers go as parties too (Z2_PARTY); the zone beam every other round only, news apart (Z2_BEAM).
constexpr bool F_V711_ZONES = true;
constexpr int Z2_BEAT_TTL = 3, Z2_MAX_K = 26, Z2_PARTY_TTL = 40, Z2_HUNT_R = 20, Z2_BEAT_MARGIN = 0, Z2_DEPART_EVERY = 4;
constexpr bool Z2_BEATS = true, Z2_MEMROOM = true, Z2_TRANSIT = true, Z2_PARTY = true, Z2_BEAM = true, Z2_CROWD = true;
constexpr int Z2_CROWD_CAP = 4, Z2_ORD_LV = 2, Z2_FAR_K = 48;

// ---- v7.12 modules (the 2026-10-05 v7.12 brief, strategyV_7_12.md). Each can be switched off on its own. ----
// F_V712_SQUEEN (Portals 1, M1107625: our queen dived into two portal chambers by round 31, split itself to 2 and died
// "trapped" in a 2x2 box in round 34; we out-ate the enemy for 450 rounds and lost on the queen). On a small map the queen's
// ID (v6 rules otherwise: F_QUEEN is off there) takes no portal (unless it stands in a small chamber, or no other move
// lives), makes no strike, splits only 2 off its tail and keeps SQ2_KEEP, is an alpha (it grows, and every other alpha
// yields to it: the feed target of the team), and from SQ2_FEED_START a share of our small dragons near it feed it (the
// round-500 tiebreak is queen length first).
constexpr bool F_V712_SQUEEN = true;
constexpr int SQ2_KEEP = 4, SQ2_FEED_START = 200, SQ2_FEED_RANGE = 12, SQ2_FEED_UNITS = 8, SQ2_FEED_SHARE_X100 = 50,
              SQ2_FEED_LEN2_ROUND = 300;
// ...and it stays nimble until SQ2_GROW_ROUND: over SQ2_CAP it sheds 2 at a time (a 17-42 long queen on Portals' tight ground
// was boxed in and starved to death in 18 of 32 games, rounds 190-310), its feeders feed it up to the cap from SQ2_FEED_START
// and without limit from SQ2_GROW_ROUND. (SQ2_CAP 0: no cap.)
constexpr int SQ2_CAP = 12, SQ2_GROW_ROUND = 400;
// ...from SQ2_START_ROUND on (before it the queen plays v7.11's small-map game: most small maps are decided by elimination in
// the opening, where the queen is a third to half of our force); the portal ban holds from round 0 when SQ2_NOPORTAL_EARLY.
constexpr int SQ2_START_ROUND = 200;
constexpr bool SQ2_NOPORTAL_EARLY = false; // (true, or SQ2_START_ROUND 0 or 100: measured harmful, strategyV_7_12.md)
// F_V712_CHAMBER (Portals 2: 336 of our 630 splits were made with the head inside a 2x2 box, 190 of our deaths were there,
// 95 of them a stub hitting the wall). No split while any segment of ours is inside a tiny chamber (CH2_TINY tiles or fewer)
// or crosses a portal (v5.8's 2-split exception included), but the survival split. A camper that walks out longer than
// CH2_LOOP_LEN does not loop straight back in: it walks out until its whole body is outside, splits there, and goes back.
constexpr bool F_V712_CHAMBER = true;
constexpr int CH2_TINY = 4, CH2_LOOP_LEN = 3, CH2_OUT_TTL = 10; // (enter at 3, eat the 4 pearls of a 2x2 box: 7, under the 8-tile loop)
// F_V712_FARM (Portals 3, M1107625 round 147: dragon 331, the rear child of a tip split in the x = 16 corridor of
// every-round spawners, walked off as an alpha). A dragon whose tail lies in a farm it is leaving sends one 2-long child back
// in (farm_harvest(), from its birth round on, with the parent's dying stub at the tip not counted as a teammate inside); one
// that cannot split loops back in (the pocket loop, at any length up to FR2_LOOP_LEN). One relay at a time per farm.
constexpr bool F_V712_FARM = true;
constexpr int FR2_LOOP_LEN = 8, FR2_LOOP_TTL = 30;
// F_V712_ONESPLIT (Trauma 1, M1107632 rounds 49 / 53: dragon 17 split into a corridor twice; the second child walked to the
// mouth of the dead end the first was working and boxed its rear child in: four dead in four rounds). No voluntary split
// whose child is born on a corridor tile that leads (through corridor tiles) to a teammate's segment, nor within OS_TTL rounds
// of our own last split made from a corridor tile within OS_R of the tail.
constexpr bool F_V712_ONESPLIT = true;
constexpr int OS_TTL = 15, OS_R = 8, OS_FLOOD = 24;
// F_V712_QSPRINT (Trauma 3): the queen spends its free steps on pearls in view: the path (up to QS2_MAX steps, every tile free
// and as safe as its steps) that eats the most pearls with no segment lost (pearls >= steps - free steps), when it eats more
// than the move it was given; only with no enemy head in view within QS2_ENEMY_R.
constexpr bool F_V712_QSPRINT = true;
constexpr int QS2_MAX = 8, QS2_ENEMY_R = 6, QS2_MIN_GAIN = 2; // (gain: length gained this turn over the given move's)
// F_V712_PORTALV (Queen of Spades 1, M1107627 round 18: dragon 6 stood at the portal into our 16-spawner enclosure and left it
// for one pearl 3 tiles off; the enemy held both enclosures from round 44). A portal whose far side we never saw, or that
// leads into a paying chamber nobody of ours holds, beats a lone pearl in view (fewer than PV_PEARLS within PV_K moves); a
// dragon that set off for such a portal keeps it as its goal for PV_TTL rounds while it is out of view.
constexpr bool F_V712_PORTALV = true;
constexpr int PV_PEARLS = 3, PV_K = 4, PV_TTL = 8, PV_MAX_K = 8, PV_SIDE = 6, PV_NEAR = 6;
// F_V712_QTRAP (Queen of Spades 2, M1110542 round 348: our 8-long queen stepped into a 1-tile alcove, its own tail on the only
// other way, rather than beside a 2-long enemy; split 8 -> 6 -> 4 -> 2 and died. Their queen was already dead: we were
// winning). Any of our queens (light, small-map, or under the queen rules) never steps where it has no way on next turn
// while some move with a way on exists, in reach of an enemy or not.
constexpr bool F_V712_QTRAP = true;
// F_V712_TIE (Queen of Spades 2 and Default M1110339: both queens dead, we held more total length and lost on the longest
// dragon, 24 against 39 and 33 against 41; at round 460 we had three alphas of 23, 11 and 4). With both queens known dead the
// longest dragon decides: no keepers, no feed waves, the feed phase TIE_EARLY rounds sooner, every alpha feeds a longer one
// (by length alone), and our longest grows.
constexpr bool F_V712_TIE = true;
constexpr int TIE_EARLY = 40, TIE_LATE = 420, TIE_EQ_STALE = 100; // (late with no news of their queen for TIE_EQ_STALE rounds: tie mode too)
// F_V712_ROOM (Default 1, M1107694 round 46: dragon 9 left the top-left room through its portal; the room spawns 3-4 times the
// map's average and the map as a whole is poor. Rooms on Default are "dry" by v5.6's absolute horizon nearly all the time:
// every camper left at once). A dragon alone in a sealed room (portal-only, up to RM_CAP tiles) stays and patrols it while
// the room's estimated yield (pearls a round, from the highest countdown seen on each tile) is at least RM_RATIO times what a
// forager expects outside (the map's yield per tile over the seen spawners, times the map's tiles, over twice our units).
constexpr bool F_V712_ROOM = true;
constexpr int RM_CAP = 48, RM_EVERY = 10, RM_MIN_SEEN = 24;
constexpr double RM_RATIO = 0.8;
// F_V712_PACK (Default 2, M1110339 rounds 277-324: our 2-long kamikazes stood beside the head of a 5-long enemy shut in a
// room 7 times and struck it 7 times out of 14; three of them circled it for 20 rounds). (a) the herd move counts the enemy
// head's replies that a small teammate's head can strike as covered, and hunters close in when two or more of us are near;
// (b) a small dragon beside an enemy head at least PK_MARGIN longer strikes it when no other enemy head can reach the drop
// sooner than one of ours (the material alone pays).
constexpr bool F_V712_PACK = true;
constexpr int PK_MARGIN = 2, PK_R = 5, PK_HUNTERS = 2;
constexpr bool PK_MOVE = false, PK_PROTECT = true; // (a) the hunters' move and the cover in the herd move (measured harmful: off), (b) the strike
// F_V712_QNOSTRIKE (Default M1107694 round 72: our 3-long queen died striking a 3-long enemy). The queen's ID never strikes.
constexpr bool F_V712_QNOSTRIKE = true;
// F_V712_INSUP (Default M1107694: three of our dragons died in unsupported intruder strikes in 160 rounds; v7.11 measured
// 36% of such a drop for us). v7.11's intruder strike only when one of ours reaches the drop before any other enemy head.
constexpr bool F_V712_INSUP = true;
// F_V712_QSAFE (Default M1110339: their queen died in round 16, ours played on in v6's light mode on a close-spawn map and died
// rammed in round 190; we then lost on the longest dragon). Once the enemy queen is known dead, ours goes over to the queen
// rules for good (the safe state): zero risk, its haven, and protect mode for the team.
constexpr bool F_V712_QSAFE = true;
// F_V712_PIPE (Portals 4: a 9-long feeder that splits into three 3s drops 6 pearls, not 5). v5.13's pipe gave its piece 3 a
// time; v7.1 turned it off within 2 of the queen's head or with the queen at 2 ways out or fewer, which is where nearly every
// delivery happens (Trauma: 1 pipe in 156 deliveries). With this the pipe runs there too unless the queen has one way out or
// fewer, or our head is on the tile in front of it.
constexpr bool F_V712_PIPE = true;

// ---- v7.13 modules (the 2026-10-05 v7.13 brief: the small-map rework; strategyV_7_13.md). Small maps only (QUEEN_SMALL_AREA
// tiles or fewer): every rule below is inert on larger maps. Each can be switched off on its own. ----
// F_V713_FRONTIER (Trophy M1130222 round 0: dragon 0 saw the kelp west of and above its spawn handle and still walked the
// handle's closed top for 15 rounds; Tower Defense M1145973: both spawn dragons walked their 7x7 box, seen whole from round 0,
// for 20-45 rounds). Exploration in view scored never-visited tiles as new ground, and a remembered pearl in a closed bag
// pulled the dragon back into it. Now, with nothing to eat and no errand: the nearest unseen tile over the remembered map
// (unseen ground open, a pull toward the map's centre of FR3_CENTRE_W a tile), walked as a leg; and until FR3_END a remembered
// or expected pearl whose detour (to it, then on to that unseen ground, against going straight there) costs more than
// FR3_SLACK + FR3_PER for each pearl round it is left.
constexpr bool F_V713_FRONTIER = true;
constexpr int FR3_TTL = 12, FR3_END = 80, FR3_SLACK = 3, FR3_PER = 3;
constexpr double FR3_CENTRE_W = 0.3;
constexpr bool FR3_PULL_SECTOR = true; // (the pull toward our exploration waypoint; false: toward the map's centre)
// F_V713_HOME (banked small maps, where the enemy reaches our home only through the middle: devil, tower_defense, weakhold;
// v7.9's bank verdict). The queen stays behind: its home is the ground within HQ_R moves of its spawn (Tower Defense
// M1145973: v7.11's home, "our side of the map", let the queen out of its box, and its way back in was refused as a dead end:
// it circled outside for 70 rounds, 2 long); it eats and patrols there and walks straight back when it is out. On the other
// small maps the queen plays as any dragon (v7.11's SQ_STAY only where the home is banked). The runner (the queen's ID + 2,
// our second spawn dragon) walks to the centre band by the remembered map, eats only pearls on its way (a step that leaves its
// remaining way as long as before) and makes no split or errand until it gets there (RN_END at the latest); then, with only
// the queen and itself alive and no pearl in sight nor due there, it claims the densest spot it saw on its way furthest from
// our spawn. Once the centre is held (v7.11's push), a dragon with nothing near walks to the nearest spawner of theirs we
// expect a pearl on (or unseen ground) a few tiles deeper than itself: their side taken bit by bit (PROP_*).
constexpr bool F_V713_HOME = true;
constexpr int HQ_R = 6, RN_END = 70, RN_DENSE = 3, RN_DRY_DUE = 10, PROP_STEP = 2, PROP_SPAN = 8, PROP_HUNT_R = 6;
constexpr double HQ_OUT_W = 300.0;
constexpr bool HQ_ON = true, RN_ON = true, PROP_ON = true;
// F_V713_PORTAL (Trophy M1141747 round 12: our dragon 3 stood beside the portal into the cup, the map's richest ground, and
// walked off; the enemy took it in round 15 and out-ate us 176 to 30 by round 100. Stripes: the enemy held both rich 2x2
// portal boxes). Small maps: (a) the portal links we know (both ends: crossed, or seen) go round the team on PLINK_TAG, so every
// dragon routes through every portal one of us knows; a link we know implies its mirror image under the map's symmetry (a
// portal end we see whose mirror is an end of a known link gets the mirror of the other end); (b) a portal whose far side we
// never saw beats a lone pearl when its mouth lies on our side or in the middle (side depth PX_SIDE or more; v7.12's PV rule
// asked for PV_SIDE, well on our side), the queen's ID too while it plays as any dragon (F_V713_QSAFE).
constexpr bool F_V713_PORTAL = true;
constexpr int PLINK_TAG = 8160, PX_SIDE = -2, PX_END = 150;
// F_V713_QSAFE (Portals, and the other small maps that are not banked: the enemy can reach us from anywhere). The queen plays
// as any dragon (portals, strikes, risks: v7.12 barred its ID from every strike) until it has gone QS3_CALM rounds without an
// enemy head within QS3_R of it (in view, or in the memory); from then on, for good, it plays v7.12's small-map queen rules
// (no portal, no strike, sheds 2 at a time and keeps SQ2_KEEP, an alpha the team feeds) and says so every QS3_EVERY rounds on
// QS3_TAG (relayed), so that teammates hearing it keep clear of it as of the small-map queen (no blocking, no portal exit
// beside it) before SQ2_START_ROUND too.
constexpr bool F_V713_QSAFE = true;
constexpr int QS3_TAG = 8159, QS3_CALM = 30, QS3_R = 6, QS3_EVERY = 3, QS3_HEARD_TTL = 40;
// ...and the small-map queen under those rules walks into no dead end, at any length, unless nothing else is left (v7.12's veto
// asked for 4 long or more: on Portals the safe queen dived the x = 16 farm corridor and died there 3 long in 8 of 16 games)
constexpr bool QS3_NOALLEY = true;
// (QS3_GROW: the queen grows from its safe round, capped at SQ2_CAP as from round 200: Portals 6 of 16 against 10, queen alive at
// the end 1 against 3; off)
constexpr bool QS3_GROW = false;
// F_V713_FARMBACK (weakhold M1145116 round 37: dragon 11, the 5-long rear child of a tip split in the (13..15, 14) farm of
// every-round spawners, walked off west; nobody of ours went back in). A dragon that came out of a rich dead end (FB_FAST or
// more fast spawners: v5.8's farms, or seen in it) splits 2 off as soon as its tail is out of it (on the junction at its mouth,
// the dead end ahead of the child): the child is born at the mouth facing in, and works it; not while one of ours (3 long or
// more: the tip split's dying stub apart) is in it. (v7.12's farm split asked for 5 or more and came while the tail was still
// inside; the 3-long rear child loops back in by v7.12's rule; a 4-long one did neither.)
constexpr bool F_V713_FARMBACK = true;
constexpr int FB_FAST = 2, FB_WINDOW = 12;
// F_V713_HOLD (weakhold weak_1.replay: our dragons took the (24, 0) chokepoint of every-round spawners in turn, and others kept
// walking up to its mouth and away again). The farm claim (v5.8's FARM_TAG, renewed by whoever works the farm) now keeps every
// errand out: a remembered, expected or visible pearl further than 1 move, a hot tile to tend, a scout spot, the frontier
// goal, inside a farm a teammate holds (claimed within FARM_CLAIM_TTL2 rounds, within HD_R of its fast tile) is left to it.
// Measured (strategyV_7_13.md, weakhold, 16 games each with traces): errands into a farm a teammate holds came at 0.35 a held
// round with it, 0.23 without; our farm pearls 82 against 99 a game. It does the opposite of what it is for: off.
constexpr bool F_V713_HOLD = false;
constexpr int HD_R = 4;
// ...and (the brief's broadcast) a dragon whose head is in a dead end of the map with HD_FAST or more pearls or fast spawners in
// view says so on HOLD_TAG (its head, every other round on one beam); a teammate hearing it keeps every errand above out of
// the ground within HD_R of it for HD_TTL rounds (no farm memory needed on either side: newborns have none).
constexpr int HOLD_TAG = 8158, HD_TTL = 8, HD_FAST = 2, HD_SPOTS = 6;
// (the hold is for dragons coming from afar: within HD_LOCAL moves of the spot it does not apply (a tip split's rear child and
// the relay child born at the mouth go back in), and a dragon shorter than HD_MIN_LEN holds nothing (the dying stub at a tip))
constexpr int HD_LOCAL = 6, HD_MIN_LEN = 3;
// F_V713_MIRROR (Stripes: we left our rich 2x2 portal box, the enemy took it and held both). A dragon camping in a rich tiny
// chamber (MR_TINY tiles or fewer, MR_SPAWNERS or more spawners) whose portal link it knows, on a map whose symmetry it knows,
// posts guards (v5.10's F_GUARD, shared on GUARD_TAG) on the two tiles beside the mirror image of the link's outer end: where
// the enemy's camper in the mirror box comes out. A guard there circles the exit and rams what comes out of it.
constexpr bool F_V713_MIRROR = true;
constexpr int MR_TINY = 4, MR_SPAWNERS = 2, MR_EVERY = 10, MR_TTL = 40;

// ---- v7.14 modules (the 2026-10-06 brief: replays M1157650 weakhold, M1157649 Trophy; strategyV_7_14.md). Each can be switched
// off on its own. ----
// F_V714_PRERAM (item 1a, M1157650 round 134: their dragon 50, 4 long, head to head with our 34, split 2 off; 34 rammed the 2-long
// front and their child 64 ate both drops). An enemy head can ram ours next turn and no move of ours gets out of its reach: a
// dragon of 4 or more splits its rear off (PR_CHILD_MAX at most: the front keeps 2), so the child lives on beside the collision and
// eats the drops; the 2-long front stays (or rams the enemy itself next turn). With no other enemy head within PR_ALONE_R of
// the collision the child is sure of the drops, and the split is made even when one way out is left (it would run into the
// enemy's reach the turn after: PR_ALONE_ESCAPES ways out or fewer).
constexpr bool F_V714_PRERAM = true;
constexpr int PR_MIN_LEN = 4, PR_ALONE_R = 4, PR_ALONE_ESCAPES = 1;
// F_V714_SPLITVETO (item 1b, the same collision; Trophy M1157649 round 39: our 21 rammed their 13 two rounds after 13 split, and
// their 9 ate the drop). An enemy that split within SV_TTL rounds (a new head of theirs came out with its tail at its tail; or,
// seen later, a head newer than every one we know, beside an older one) is struck only when one of ours (the striker apart; in
// view, or the memory's of the last 2 rounds) reaches the drop before the other half of that split, by moves and turn order:
// whatever path asked for the strike (aggression mode and the memory strikes too). The enemy queen and threats to our queen are
// exempt.
constexpr bool F_V714_SPLITVETO = true;
constexpr int SV_TTL = 3, SV_IDS = 16384, SV_SLOTS = 8, SV_NEAR = 3;
// (SV_SMALL_ONLY: small maps only. On the large maps, against the module off on 44 games of the shipped build: 18 wins against 23;
// there it vetoed 25-73 strikes a game, many dragons being "new" to us. On small maps all 56 games ended as with it off. Both
// replays were small maps.)
constexpr bool SV_SMALL_ONLY = true;
// F_V714_SIDE (item 1c, M1157650 rounds 154-200: four to seven of ours circled our spawn in "push"). The sides of the map went by
// torus distance: on weakhold the wrap seam behind our spawn (x 0 / 39) is kelp, but by the torus our spawn and theirs are 5
// apart across it, so the strip behind our own spawn scored as the middle and v7.13's push (prop_target(): spawners 2-8 units
// deeper than us, on their side) sent dragons to x 0-3 of our home: 11-51% of push goals in six local games. With the seam known
// to be closed, side_depth() measures along the seam's axis without wrapping.
constexpr bool F_V714_SIDE = true;
// F_V714_FUTILE (item 2, M1157649 rounds 31-38: our 21 trailed their 13 one column behind; 13 moved first each round, ate the

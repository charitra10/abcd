constexpr int FU_MIN_K = 2, FU_CHASE = 4, FU_TTL = 15, FU_MAX_LEN = 5, FU_SLOTS = 6;
// (FU_SMALL_ONLY: small maps only. On the large maps, against the module off on 44 games: 17 wins against 24, futile chase turns
